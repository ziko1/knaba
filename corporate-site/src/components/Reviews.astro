---
import PublicReviews from './PublicReviews';
import {reviewsCopy, type ReviewLocale} from '../data/reviews';
import {knabaExternalRating as rating} from '../data/external-rating';
import '../styles/reviews.css';
const {locale='de'} = Astro.props as {locale: ReviewLocale};
const t=reviewsCopy[locale];
const contact=(locale==='de'?'':'/'+locale)+'/kontakt/';
const sourceCopy={
  de:{eyebrow:'UNABHÄNGIGE QUELLE · DATENSTAND 2025',title:'Öffentlich erfasste Bewertungen',count:'2 Google-Maps-Bewertungen, zusammengefasst bei ProvenExpert',asOf:'Stand der Quellenangabe:',caution:'Historischer Wert, keine live geprüfte Bewertung. Einzelne Rezensionstexte sind nicht unabhängig verifiziert.',source:'Originalquelle bei ProvenExpert öffnen'},
  en:{eyebrow:'THIRD-PARTY SOURCE · 2025 SNAPSHOT',title:'Ratings from an independent source',count:'2 Google Maps ratings aggregated by ProvenExpert',asOf:'Source data dated:',caution:'Historical snapshot, not a live rating. Individual review texts have not been independently verified.',source:'View the source on ProvenExpert'},
  uk:{eyebrow:'НЕЗАЛЕЖНЕ ДЖЕРЕЛО · ДАНІ ЗА 2025 РІК',title:'Оцінки з відкритого джерела',count:'2 оцінки Google Maps, узагальнені ProvenExpert',asOf:'Стан даних джерела:',caution:'Історичний показник, а не актуальна оцінка наживо. Тексти окремих відгуків не перевірені незалежно.',source:'Переглянути джерело ProvenExpert'},
  ru:{eyebrow:'НЕЗАВИСИМЫЙ ИСТОЧНИК · ДАННЫЕ ЗА 2025 ГОД',title:'Оценки из открытого источника',count:'2 оценки Google Maps, агрегированные ProvenExpert',asOf:'Дата данных источника:',caution:'Историческое значение, не текущий рейтинг. Тексты отдельных отзывов независимо не проверены.',source:'Открыть источник ProvenExpert'}
}[locale];
const score=locale==='en'?rating.average.toFixed(1):rating.average.toFixed(1).replace('.',',');
---
<section class="container knaba-reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="reviews-heading">
    <div><p class="reviews-kicker">{t.label}</p><h2 id="reviews-title">{t.title}</h2></div>
    <p>{t.intro}</p>
  </div>
  <div class="external-review-evidence" aria-labelledby="external-review-title">
    <div class="external-review-score-panel">
      <p class="external-review-eyebrow">{sourceCopy.eyebrow}</p>
      <p class="external-review-score">{score}<span> / {rating.scale}</span></p>
      <span class="external-review-stars" aria-hidden="true">★★★★★</span>
    </div>
    <div class="external-review-details">
      <h3 id="external-review-title">{sourceCopy.title}</h3>
      <p class="external-review-count">{sourceCopy.count}</p>
      <p class="external-review-note">{sourceCopy.asOf} <time datetime={rating.asOf}>{rating.asOfDisplay}</time>. {sourceCopy.caution}</p>
      <a href={rating.sourceUrl} rel="noopener noreferrer">{sourceCopy.source}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <PublicReviews locale={locale} client:visible />
  <p class="reviews-fine-print"><a href="https://www.google.com/maps?cid=6323808801410846096">Google Maps <span aria-hidden="true">↗</span></a></p>
  <noscript><p class="reviews-notice">{t.noScript} <a href={contact}>{t.contact} ↗</a></p></noscript>
</section>
<style>
.external-review-evidence{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:24px;align-items:center;border:1px solid #c9dcd4;border-radius:22px;background:linear-gradient(125deg,#e4f4e9,#f5f8ee);padding:clamp(22px,3.5vw,38px);margin-bottom:30px;overflow-wrap:anywhere}
.external-review-score{font-size:clamp(42px,5vw,66px);line-height:1.1;letter-spacing:-.055em;font-weight:850;color:#0b313b;margin:0}
.external-review-score>span{font-size:.42em;letter-spacing:0}
.external-review-stars{color:#987019;font-size:20px;letter-spacing:.12em}
.external-review-details h3{font-size:clamp(19px,2.5vw,28px);line-height:1.3;margin:0 0 12px}
.external-review-count{font-weight:700}
.external-review-note{font-size:13px;line-height:1.75;color:#46615a}
.external-review-details>a{display:inline-flex;align-items:center;gap:12px;min-height:44px;font-size:14px;font-weight:750;color:#075f65;text-underline-offset:4px}
.external-review-details>a:focus-visible{outline:3px solid #08777b;outline-offset:4px}
@media(max-width:650px){.external-review-evidence{grid-template-columns:1fr}}
</style>
