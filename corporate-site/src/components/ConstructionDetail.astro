---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import {company} from '../data/company';
import {siteConfig} from '../data/site';
import type {ConstructionLocale,ConstructionOffer} from '../data/construction-offers';
import {constructionBusinessCopy as copy,localeValue,offerBySlug} from '../data/construction-offers';
import {constructionServiceContent,serviceContentCopy} from '../data/construction-service-content';
const {locale='de',offer}=Astro.props as {locale:ConstructionLocale,offer:ConstructionOffer};
const t=copy[locale];const prefix=locale==='de'?'':'/'+locale;
const title=localeValue(offer.name,locale);const desc=localeValue(offer.description,locale);
const contact=prefix+'/kontakt/?anliegen='+offer.slug;
const isSpecial=!offer.core;
const detail=constructionServiceContent[offer.slug];
const label=(key:keyof typeof serviceContentCopy)=>serviceContentCopy[key][locale];
const related=detail.related.map(slug=>offerBySlug(slug)).filter((item):item is ConstructionOffer=>Boolean(item));
const serviceUrl=siteConfig.origin+prefix+'/bauleistungen/'+offer.slug+'/';
---
<Layout hasInlinePhone lang={locale} title={title+' | KnaBa Berlin'} description={desc}
breadcrumbs={[{name:'KnaBa',url:prefix+'/'},{name:t.all,url:prefix+'/leistungen/'},{name:title,url:prefix+'/bauleistungen/'+offer.slug+'/'}]}
schema={{'@type':'Service','@id':serviceUrl+'#service',url:serviceUrl,name:title,description:desc,serviceType:title,provider:{'@id':siteConfig.origin+'/#business'},areaServed:['Berlin','Brandenburg']}}>
<section class="container page-intro"><a class="breadcrumb" href={prefix+'/leistungen/'}>← {t.all}</a><p class="eyebrow">{isSpecial?t.optional:t.standard}</p><h1>{title}</h1><p>{desc}</p><a class="button button-dark" href={contact}>{t.request} <Icon size={18}/></a></section>
<section class="container section section-tight detail-grid"><div class="service-overview"><h2>{label('overview')}</h2>
<p>{detail.overview[locale]}</p>
<ul class="service-stages">{offer.steps.map(item=><li>{localeValue(item,locale)}</li>)}</ul>
{isSpecial && <div class="bau-warning" role="note"><strong>{t.contract}</strong><p>{t.contractIntro}</p></div>}
</div><aside class="aside-card"><p class="eyebrow">KnaBa · {t.region}</p><h2>{t.phases}</h2><ol>{t.steps.map(step=><li>{step}</li>)}</ol>
<p><a href={company.phoneHref}>{company.phone}</a></p><p class="bau-note">{t.note}</p></aside></section>
<section class="container section section-tight service-content-grid" aria-label={label('scope')}>
  <article class="service-content-card"><p class="eyebrow">01</p><h2>{label('scope')}</h2><ul>{detail.scope.map(item=><li>{item[locale]}</li>)}</ul></article>
  <article class="service-content-card service-content-card-prep"><p class="eyebrow">02</p><h2>{label('prepare')}</h2><ul>{detail.prepare.map(item=><li>{item[locale]}</li>)}</ul><a class="text-link" href={prefix+'/ratgeber/'}>{label('guide')} ↗</a></article>
</section>
<section class="container section section-tight service-expectations">
  <div><h2>{label('limits')}</h2><p>{detail.limits[locale]}</p></div>
  <div><h2>{label('handover')}</h2><p>{detail.handover[locale]}</p></div>
</section>
<section class="container section section-tight service-quote"><div><h2>{label('pricing')}</h2><p>{label('priceText')}</p></div></section>
<section class="container section section-tight service-related" aria-labelledby="service-related-title"><h2 id="service-related-title">{label('related')}</h2><div class="service-related-grid">
{related.map(item=><a class="service-related-link" href={prefix+'/bauleistungen/'+item.slug+'/'}><h3>{item.name[locale]}</h3><p>{item.description[locale]}</p><span>{t.details} →</span></a>)}
</div><a class="text-link service-faq-link" href={prefix+'/faq/'}>{label('faq')} ↗</a></section>
<section class="container cta-banner"><div><h2>{t.ready}</h2></div><a class="button button-dark" href={contact}>{t.cta} →</a></section>
</Layout>
<style>
.bau-note{color:#566f6b;line-height:1.7;margin:25px 0}.bau-warning{border-radius:16px;background:#fff1d4;border:1px solid #e9c985;padding:22px;margin:24px 0;color:#56432d}.bau-warning p{color:#56432d;line-height:1.65}.aside-card li{margin:10px 0;color:#415954;line-height:1.55}
.service-overview,.service-content-card,.service-expectations>div,.service-quote>div{min-width:0}
.service-overview>p,.service-content-card li,.service-expectations p,.service-quote p{font-size:16px;line-height:1.8;color:#415954;overflow-wrap:anywhere}
.service-overview>p,.service-expectations p,.service-quote p{max-width:72ch}
.service-stages{list-style:none;display:flex;flex-wrap:wrap;gap:10px;padding:0;margin:24px 0}
.service-stages li{padding:9px 13px;border-radius:12px;background:#e8f3eb;color:#174d4e;font-size:14px;line-height:1.5;overflow-wrap:anywhere}
.service-content-grid,.service-expectations{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.service-content-card{padding:clamp(22px,3vw,36px);background:#eaf4ed;border:1px solid #d5e7dc;border-radius:22px}
.service-content-card-prep{background:#e7f1f4;border-color:#d2e3e7}
.service-content-card h2,.service-expectations h2,.service-quote h2,.service-related h2{font-size:clamp(24px,2.6vw,34px);line-height:1.2;letter-spacing:-.035em;overflow-wrap:anywhere}
.service-content-card ul{padding-left:22px;margin:22px 0}.service-content-card li+li{margin-top:14px}
.service-content-card li::marker{color:#08777b}.service-content-card .text-link,.service-faq-link{display:inline-flex;align-items:center;min-height:44px;line-height:1.5}
.service-expectations{border-bottom:1px solid #d8e6df;padding-bottom:32px}
.service-quote{display:block}.service-quote>div{max-width:72ch}
.service-related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:24px}
.service-related-link{display:flex;flex-direction:column;padding:24px;border-radius:18px;border:1px solid #d6e5dd;background:#f3f7f0;color:#143d42;text-decoration:none;min-width:0}
.service-related-link h3{font-size:20px;line-height:1.3;margin:0 0 12px;overflow-wrap:anywhere}.service-related-link p{font-size:14px;line-height:1.7;margin:0 0 20px;color:#415954;overflow-wrap:anywhere}.service-related-link span{margin-top:auto;color:#086c72;font-size:14px;font-weight:800}
.service-related-link:hover{border-color:#167b7a}.service-related-link:focus-visible{outline:3px solid #08777b;outline-offset:4px}.service-faq-link{margin-top:20px}
@media(max-width:760px){.service-content-grid,.service-expectations{grid-template-columns:1fr}.service-related-grid{grid-template-columns:1fr}}
</style>
