---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import {company} from '../data/company';
import {siteConfig} from '../data/site';
import type {ConstructionLocale,ConstructionOffer} from '../data/construction-offers';
import {constructionBusinessCopy as copy,localeValue} from '../data/construction-offers';
const {locale='de',offer}=Astro.props as {locale:ConstructionLocale,offer:ConstructionOffer};
const t=copy[locale];const prefix=locale==='de'?'':'/'+locale;
const title=localeValue(offer.name,locale);const desc=localeValue(offer.description,locale);
const contact=prefix+'/kontakt/?anliegen='+offer.slug;
const isSpecial=!offer.core;
const serviceUrl=new URL(prefix+'/bauleistungen/'+offer.slug+'/',siteConfig.origin).href;
const related=(await import('../data/construction-offers')).constructionOffers.filter(candidate=>candidate.slug!==offer.slug && candidate.core===offer.core).slice(0,2);
---
<Layout lang={locale} title={title+' | KnaBa Berlin'} description={desc}
breadcrumbs={[{name:'KnaBa',url:prefix+'/'},{name:t.all,url:prefix+'/leistungen/'},{name:title,url:prefix+'/bauleistungen/'+offer.slug+'/'}]}
schema={{'@type':'Service','@id':serviceUrl+'#service',url:serviceUrl,name:title,description:desc,serviceType:title,provider:{'@id':'https://knaba.de/#business'},areaServed:['Berlin','Brandenburg']}}>
<section class="container page-intro bau-detail-intro" data-offer={offer.slug}><a class="breadcrumb" href={prefix+'/leistungen/'}>← {t.all}</a><p class="eyebrow">{isSpecial?t.optional:t.standard}</p><h1>{title}</h1><p>{desc}</p><a class="button button-dark" href={contact}>{t.request} <Icon size={18}/></a></section>
<section class="container section section-tight detail-grid"><div><h2>{t.focus}</h2>
<ul class="check-list">{offer.steps.map(item=><li><Icon name="check" size={20}/>{localeValue(item,locale)}</li>)}</ul>
<p class="bau-note">{t.note}</p>
{isSpecial && <div class="bau-warning" role="note"><strong>{t.contract}</strong><p>{t.contractIntro}</p></div>}
</div><aside class="aside-card"><p class="eyebrow">KnaBa · {t.region}</p><h2>{t.phases}</h2><ol>{t.steps.map(step=><li>{step}</li>)}</ol>
<a class="text-link" href={contact}>{t.request} ↗</a><p><a href={company.phoneHref}>{company.phone}</a></p></aside></section>
<section class="container bau-detail-related" aria-label={t.all}><h2>{t.all}</h2><div class="bau-detail-related-grid">
{related.map(item=><a href={prefix+'/bauleistungen/'+item.slug+'/'}><span aria-hidden="true">{item.icon}</span><strong>{localeValue(item.name,locale)}</strong><span aria-hidden="true">↗</span></a>)}
</div></section>
<section class="container cta-banner"><div><h2>{t.ready}</h2></div><a class="button button-dark" href={contact}>{t.cta} →</a></section>
</Layout>
<style>
.bau-detail-intro{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(120deg,#d2f1ef,#f5f8de);border:1px solid #d8e8da;border-radius:28px;margin-top:27px;margin-bottom:14px;padding:clamp(28px,5vw,68px)}
.bau-detail-intro::before{content:'';position:absolute;right:-105px;top:-95px;width:295px;height:295px;border:37px solid #ffffff60;border-radius:50%;z-index:-1}
.bau-detail-intro[data-offer="bauzwischenreinigung"],.bau-detail-intro[data-offer="bauendreinigung"]{background:linear-gradient(120deg,#e5def9,#fcf0e5)}
.bau-detail-intro[data-offer="baustellenraeumung"],.bau-detail-intro[data-offer="bauhilfe"]{background:linear-gradient(120deg,#f8d5bb,#fff1da)}
.bau-detail-intro[data-offer="kernbohrungen"],.bau-detail-intro[data-offer="durchbrueche"],.bau-detail-intro[data-offer="zusatzarbeiten"]{background:linear-gradient(120deg,#d9e8fd,#e8e0fa)}
.bau-detail-intro h1{font-size:clamp(36px,5.2vw,70px);line-height:1.08;overflow-wrap:anywhere;text-wrap:balance}
.bau-detail-intro>p{max-width:660px}.bau-detail-intro .button{margin-top:8px}
.bau-detail-related{padding-bottom:38px}.bau-detail-related h2{font-size:clamp(24px,2.8vw,36px);margin-bottom:19px}
.bau-detail-related-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.bau-detail-related-grid a{display:flex;align-items:center;gap:16px;min-width:0;padding:22px 24px;border-radius:17px;background:#e8f5f1;border:1px solid #d4e7dd;font-size:15px;text-decoration:none}
.bau-detail-related-grid a:nth-child(2){background:#f5eafa;border-color:#e6d9f0}
.bau-detail-related-grid a strong{flex:1;overflow-wrap:anywhere}.bau-detail-related-grid a span:first-child{font-size:25px}
.bau-detail-related-grid a:focus-visible{outline:3px solid #c08f36;outline-offset:3px}
@media(max-width:610px){.bau-detail-related-grid{grid-template-columns:1fr}.bau-detail-intro{border-radius:20px;margin-top:12px}}
.bau-note{color:#566f6b;line-height:1.7;margin:25px 0}.bau-warning{border-radius:16px;background:#fff1d4;border:1px solid #e9c985;padding:22px;margin:24px 0;color:#56432d}.bau-warning p{color:#56432d;line-height:1.65}.aside-card li{margin:10px 0;color:#415954;line-height:1.55}.check-list{padding-left:0}.check-list li{display:flex;gap:12px;align-items:flex-start}
</style>
