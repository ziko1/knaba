---
import Layout from '../layouts/Layout.astro';
import type { ConstructionLocale } from '../data/construction-offers';
const {locale='de'} = Astro.props as {locale:ConstructionLocale};
const prefix = locale === 'de' ? '' : '/' + locale;
const copy = {
  de: {label:'KNABA / GALERIE',title:'Einblicke in unsere Arbeitsbereiche',intro:'Baureinigung, Baustellenvorbereitung und saubere Übergaben: typische Arbeitsschritte rund um Ihr Projekt.',notice:'Illustrative Darstellungen, keine Fotos dokumentierter Kundenaufträge. Echte Projektbilder veröffentlichen wir erst nach Freigabe der Bild- und Persönlichkeitsrechte.',alt:'Symbolische Illustration',action:'Projekt anfragen',items:[
    ['Baureinigung nach Bauabschnitt','Grob-, Zwischen- und Endreinigung werden passend zum Baufortschritt abgestimmt.'],
    ['Baustellenvorbereitung','Arbeitsbereiche, sichere Zugänge und Abläufe vor Beginn klären.'],
    ['Glas- und Oberflächenreinigung','Material, Erreichbarkeit und Reinigungsverfahren abstimmen.'],
    ['Saubere Objektübergabe','Abnahmebereiche und Nachkontrollen gemeinsam festlegen.']
  ]},
  en: {label:'KNABA / GALLERY',title:'Explore our areas of work',intro:'Construction cleaning, site preparation and handover: the kinds of work to discuss with KnaBa.',notice:'Original illustrations, not photographs of completed client work. Real project images require clearance for image and personal rights.',alt:'Illustrative graphic',action:'Enquire about a project',items:[
    ['Cleaning throughout construction','Agree rough, interim and final cleaning for each phase.'],
    ['Preparing the site','Review safe access, work areas and site procedures.'],
    ['Glass and surface cleaning','Agree materials, access and cleaning methods.'],
    ['Preparing for handover','Define inspection zones and final checks.']
  ]},
  uk: {label:'KNABA / ГАЛЕРЕЯ',title:'Наші напрями роботи',intro:'Будівельний клінінг, підготовка майданчика та здача об’єкта — типові процеси, які можна узгодити з KnaBa.',notice:'Оригінальні схематичні ілюстрації, а не фото виконаних замовлень. Реальні знімки публікуються після перевірки прав на зображення й приватності.',alt:'Схематична ілюстрація',action:'Надіслати запит',items:[
    ['Прибирання за етапами','Узгодження грубого, проміжного та фінального прибирання.'],
    ['Підготовка майданчика','Погодження доступу, робочих зон і правил безпеки.'],
    ['Скло та поверхні','Перевірка матеріалів і технології очищення.'],
    ['Підготовка до здачі','Узгодження зон приймання та фінального контролю.']
  ]},
  ru: {label:'KNABA / ГАЛЕРЕЯ',title:'Наши направления работы',intro:'Строительный клининг, подготовка площадки и сдача объекта — типовые процессы, которые можно обсудить с KnaBa.',notice:'Оригинальные схематические иллюстрации, а не фотографии выполненных заказов. Реальные снимки публикуются после проверки прав на изображения и конфиденциальности.',alt:'Схематическая иллюстрация',action:'Отправить запрос',items:[
    ['Уборка по этапам','Согласование черновой, промежуточной и финальной уборки.'],
    ['Подготовка площадки','Согласование доступа, рабочих зон и безопасности.'],
    ['Стёкла и поверхности','Проверка материалов и метода очистки.'],
    ['Подготовка к сдаче','Согласование зон приёмки и финального контроля.']
  ]}
} as const;
const t=copy[locale];
const images=['/illustrations/baureinigung.svg','/illustrations/hero-cleaning.svg','/illustrations/glasreinigung.svg','/illustrations/treppenreinigung.svg'] as const;
---
<Layout lang={locale} title={t.title + ' | KnaBa Berlin'} description={t.intro} schema={{'@type':'CollectionPage',name:t.title,inLanguage:locale}}>
  <section class="container knaba-gallery" aria-labelledby="knaba-gallery-title">
    <header class="knaba-gallery-header">
      <p class="knaba-gallery-eyebrow">{t.label}</p>
      <h1 id="knaba-gallery-title">{t.title}</h1>
      <p class="knaba-gallery-intro">{t.intro}</p>
      <p class="knaba-gallery-notice">{t.notice}</p>
    </header>
    <ul class="knaba-gallery-grid" role="list">
      {t.items.map(([title,description],index) => (
        <li class="knaba-gallery-card">
          <figure>
            <img src={images[index]} alt={t.alt + ': ' + title} width="960" height="640" loading="lazy" decoding="async" />
            <figcaption>
              <span class="knaba-gallery-number">{String(index+1).padStart(2,'0')}</span>
              <h2>{title}</h2>
              <p>{description}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <a class="button button-dark knaba-gallery-cta" href={prefix+'/kontakt/'}>{t.action} <span aria-hidden="true">↗</span></a>
  </section>
</Layout>
<style>
.knaba-gallery{padding-block:clamp(36px,6vw,92px);min-width:0}
.knaba-gallery-header{max-width:850px;margin-bottom:clamp(28px,4vw,48px)}
.knaba-gallery-eyebrow{color:#087e86;font-size:13px;font-weight:850;letter-spacing:.13em}
.knaba-gallery h1{font-size:clamp(34px,5vw,66px);line-height:1.12;letter-spacing:-.055em;color:#0b313b;overflow-wrap:anywhere;margin:15px 0}
.knaba-gallery-intro{color:#405f58;font-size:clamp(17px,2vw,21px);line-height:1.6}
.knaba-gallery-notice{padding:14px 18px;background:#eff6f0;border-left:3px solid #0b8686;color:#345a57;line-height:1.5;font-size:14px;border-radius:8px}
.knaba-gallery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(14px,2vw,24px);padding:0;margin:0 0 30px;list-style:none}
.knaba-gallery-card{overflow:hidden;border:1px solid #cce0d8;border-radius:24px;background:#eef8f3;min-width:0}
.knaba-gallery-card:nth-child(2){background:#eef2fa}.knaba-gallery-card:nth-child(3){background:#f7f0e8}.knaba-gallery-card:nth-child(4){background:#f1edf9}
.knaba-gallery-card figure{margin:0}
.knaba-gallery-card img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;padding:clamp(12px,2.8vw,30px);box-sizing:border-box}
.knaba-gallery-card figcaption{padding:clamp(20px,2.5vw,32px);background:#ffffffc9}
.knaba-gallery-number{font-size:12px;color:#087f85;font-weight:850;letter-spacing:.08em}
.knaba-gallery-card h2{font-size:clamp(20px,2.4vw,28px);margin:14px 0 10px;color:#14343b;letter-spacing:-.03em}
.knaba-gallery-card p{font-size:15px;line-height:1.65;color:#405d57;margin:0}
.knaba-gallery-cta{margin-top:8px}.knaba-gallery-cta:focus-visible{outline:3px solid #087e86;outline-offset:4px}
@media(max-width:680px){.knaba-gallery-grid{grid-template-columns:1fr}.knaba-gallery-card img{max-height:340px}}
</style>
