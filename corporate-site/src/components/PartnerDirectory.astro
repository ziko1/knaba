---
import Layout from '../layouts/Layout.astro';
import {officialPartnerLogos,partnerCopy,partnerDirectoryCopy} from '../data/partners';
import type {ConstructionLocale} from '../data/construction-offers';
const {locale='de'}=Astro.props as {locale:ConstructionLocale};
const t=partnerDirectoryCopy[locale];
const prefix=locale==='de'?'':'/'+locale;
const homeLabel={de:'Startseite',en:'Home',uk:'Головна',ru:'Главная'}[locale];
const alternates=(['de','en','uk','ru'] as const).map(lang=>({lang,url:(lang==='de'?'':'/'+lang)+'/partner/'}));
---
<Layout lang={locale} title={t.title+' | KnaBa'} description={t.intro}
  breadcrumbs={[{name:homeLabel,url:prefix+'/'},{name:t.title,url:prefix+'/partner/'}]}
  alternates={alternates} schema={{'@type':'CollectionPage',name:t.title,inLanguage:locale}}>
  <section class="container partner-directory" aria-labelledby="partner-directory-title">
    <header class="partner-directory-heading">
      <p class="eyebrow">{partnerCopy[locale].eyebrow}</p>
      <h1 id="partner-directory-title">{t.title}</h1>
      <p>{t.intro}</p>
    </header>
    <nav class="partner-directory-index" aria-label={t.index}>
      {officialPartnerLogos.map(partner=><a class="button button-outline" href={'#'+partner.slug}>{partner.name}</a>)}
    </nav>
    <div class="partner-directory-list">
      {officialPartnerLogos.map(partner=>(
        <article id={partner.slug} class="partner-directory-profile" aria-labelledby={partner.slug+'-title'} tabindex="-1">
          <div class="partner-directory-logo"><img src={partner.src} alt={partnerCopy[locale].logo+' '+partner.name} width={partner.width} height={partner.height} loading="lazy" decoding="async" /></div>
          <div><h2 id={partner.slug+'-title'}>{partner.name}</h2><p>{partner.description[locale]}</p></div>
        </article>
      ))}
    </div>
  </section>
</Layout>
<style>
.partner-directory{padding-block:clamp(40px,6vw,90px)}
.partner-directory-heading{max-width:780px}.partner-directory-heading h1{font-size:clamp(36px,5vw,68px);line-height:1.08;letter-spacing:-.05em;color:#0b313b;overflow-wrap:anywhere}.partner-directory-heading>p:last-child{font-size:clamp(17px,2vw,21px);line-height:1.65;color:#405f58;margin-top:24px}
.partner-directory-index{display:flex;flex-wrap:wrap;gap:10px;margin-block:28px 38px}.partner-directory-index a{white-space:normal;overflow-wrap:anywhere}.partner-directory-profile:focus-visible{outline:3px solid #08777b;outline-offset:4px}
.partner-directory-list{display:grid;gap:18px}.partner-directory-profile{display:grid;grid-template-columns:minmax(150px,220px) minmax(0,1fr);gap:clamp(24px,4vw,56px);align-items:center;scroll-margin-top:140px;padding:clamp(24px,4vw,44px);background:#fff;border:1px solid #d5e5df;border-radius:24px}.partner-directory-profile h2{font-size:clamp(23px,3vw,34px);line-height:1.2;color:#0b313b;overflow-wrap:anywhere}.partner-directory-profile p{line-height:1.75;color:#405f58;margin:16px 0 0;max-width:68ch;overflow-wrap:anywhere}.partner-directory-logo{display:flex;align-items:center;justify-content:center;min-height:120px;min-width:0}.partner-directory-logo img{width:auto;height:auto;max-width:100%;max-height:130px;object-fit:contain}
@media(max-width:620px){.partner-directory-profile{grid-template-columns:1fr;gap:18px}.partner-directory-logo{min-height:100px;justify-content:flex-start}.partner-directory-logo img{max-height:110px;max-width:210px}.partner-directory-index a{max-width:100%}}
</style>
