---
import Layout from '../layouts/Layout.astro';
import Inquiry from './Inquiry';
import {company} from '../data/company';
import {constructionBusinessCopy as c} from '../data/construction-offers';
import type {ConstructionLocale} from '../data/construction-offers';
const {locale='de'}=Astro.props as {locale:ConstructionLocale};
const t=c[locale];
const translated={
 de:{k:'KONTAKT / BAU',title:'Ihr Bauprojekt. Unser nächstes Gespräch.',intro:'Erzählen Sie von der Baustelle und dem Bauabschnitt. Wir prüfen die passende Baureinigung oder Zusatzleistung und klären die Konditionen persönlich.',contact:'Direkter Kontakt',phone:'Telefon',email:'E-Mail',address:'Adresse',disclaimer:'Spezielle Bauarbeiten sind kein automatisches Angebot; Qualifikation, Statik, Schutzmaßnahmen und Vertrag werden separat geprüft.',script:'Beschreiben Sie die Zusatzarbeiten im Nachrichtenfeld der Anfrage.'},
 en:{k:'CONTACT / CONSTRUCTION',title:'Your project. Our next conversation.',intro:'Tell us about your site and stage. We can discuss construction cleaning and assess any special requests individually.',contact:'Get in touch',phone:'Phone',email:'Email',address:'Address',disclaimer:'Special construction works require technical evaluation, qualified contractors, approvals and a separate agreement.',script:'Describe special tasks in the message field.'},
 uk:{k:'КОНТАКТИ / БУДІВНИЦТВО',title:'Ваш об’єкт. Наші наступні домовленості.',intro:'Розкажіть про майданчик та етап робіт. Обговоримо клінінг і перевіримо можливість додаткових послуг.',contact:'Зв’язатися напряму',phone:'Телефон',email:'Пошта',address:'Адреса',disclaimer:'Спеціальні роботи потребують технічної оцінки, кваліфікованих виконавців, дозволів та окремого договору.',script:'Опишіть додаткові завдання в полі повідомлення.'},
 ru:{k:'КОНТАКТЫ / СТРОИТЕЛЬСТВО',title:'Ваш объект. Наши следующие договорённости.',intro:'Расскажите о площадке и этапе работ. Обсудим клининг и проверим возможность дополнительных услуг.',contact:'Связаться напрямую',phone:'Телефон',email:'Почта',address:'Адрес',disclaimer:'Специальные работы требуют технической оценки, квалифицированных исполнителей, разрешений и отдельного договора.',script:'Опишите дополнительные задачи в поле сообщения.'}
}[locale];
---
<Layout lang={locale} title={translated.title+' | KnaBa'} description={translated.intro}>
<section class="container page-intro"><p class="eyebrow">{translated.k}</p><h1>{translated.title}</h1><p>{translated.intro}</p></section>
<section class="container contact-layout">
<div class="contact-details"><h2>{translated.contact}</h2>
<div class="contact-item"><div><small>{translated.phone}</small><a href={company.phoneHref}>{company.phone}</a></div></div>
<div class="contact-item"><div><small>{translated.email}</small><a href={'mailto:'+company.email}>{company.email}</a></div></div>
<div class="contact-item"><div><small>{translated.address}</small><p>{company.street}, {company.city}</p></div></div>
<p class="notice">{translated.disclaimer}</p><p>{translated.script}</p>
</div>
<div><Inquiry locale={locale} client:load/><noscript><div class="aside-card"><h2>{t.cta}</h2><a class="button button-dark" href={'mailto:'+company.email}>{company.email}</a></div></noscript></div>
</section>
</Layout>
