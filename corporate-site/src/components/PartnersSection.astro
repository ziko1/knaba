---
import {officialPartnerLogos, partnerCopy} from '../data/partners';
import type {ConstructionLocale} from '../data/construction-offers';
const {locale='de'} = Astro.props as {locale: ConstructionLocale};
const t=partnerCopy[locale];
---
<section class="container knaba-partners" id="partner" aria-labelledby="knaba-partners-heading">
  <header class="knaba-partners-heading">
    <p class="knaba-partners-eyebrow">{t.eyebrow}</p>
    <h2 id="knaba-partners-heading">{t.title}</h2>
    <p>{t.description}</p>
  </header>
  <ul class="knaba-partners-grid" role="list">
    {officialPartnerLogos.map((partner, index) => (
      <li class="knaba-partner-card">
        <div class="knaba-partner-image">
          <img
            src={partner.src}
            alt={partner.name ? `${t.logo} ${partner.name}` : `${t.unnamed} ${index + 1}`}
            width={partner.width}
            height={partner.height}
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        </div>
        {partner.name && <p class="knaba-partner-name">{partner.name}</p>}
      </li>
    ))}
  </ul>
</section>
<style>
.knaba-partners{padding-block:clamp(44px,6vw,88px);min-width:0}
.knaba-partners-heading{max-width:800px;margin-bottom:clamp(22px,3vw,40px)}
.knaba-partners-eyebrow{font-size:12px;letter-spacing:.13em;text-transform:uppercase;font-weight:850;color:#087e86}
.knaba-partners-heading h2{font-size:clamp(32px,4vw,54px);line-height:1.12;letter-spacing:-.05em;color:#0b313b;margin:14px 0 18px;text-wrap:balance}
.knaba-partners-heading>p:last-child{color:#49645f;line-height:1.65;font-size:clamp(15px,1.45vw,18px)}
.knaba-partners-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));list-style:none;padding:0;margin:0;gap:clamp(10px,1.3vw,18px)}
.knaba-partner-card{display:flex;flex-direction:column;justify-content:center;align-items:center;min-width:0;min-height:196px;padding:clamp(14px,2vw,24px);background:#fff;border:1px solid #d5e5df;border-radius:24px;box-shadow:0 8px 24px #12343c08;transition:box-shadow .2s,border-color .2s}
.knaba-partner-card:nth-child(2){background:#fbfdf9}.knaba-partner-card:nth-child(4){background:#f8f9ff}
.knaba-partner-image{width:100%;min-height:106px;display:flex;align-items:center;justify-content:center}
.knaba-partner-image img{display:block;width:auto;height:auto;max-width:100%;max-height:105px;object-fit:contain;overflow-wrap:anywhere}
.knaba-partner-name{font-size:clamp(11px,1vw,14px);font-weight:700;line-height:1.45;text-align:center;color:#3d5d56;overflow-wrap:anywhere;margin:16px 0 0}
@media(max-width:1050px){.knaba-partners-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:580px){.knaba-partners-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.knaba-partner-card{min-height:175px;border-radius:19px;padding:14px}.knaba-partner-image{min-height:90px}.knaba-partner-image img{max-height:90px}.knaba-partner-card:last-child:nth-child(odd){grid-column:1/-1;background:linear-gradient(115deg,#f4fbf7,#eef7fa)}}
@media(max-width:339px){.knaba-partners-grid{grid-template-columns:1fr}.knaba-partner-card:last-child:nth-child(odd){grid-column:auto}}
@media(prefers-reduced-motion:reduce){.knaba-partner-card{transition:none}}
</style>
