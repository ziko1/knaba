---
import type {ConstructionLocale} from '../data/construction-offers';
import projectIntents from '../data/project-intents.json';

const {locale='de'}=Astro.props as {locale:ConstructionLocale};
const prefix=locale==='de'?'':'/'+locale;
const copy=projectIntents[locale];
---
<section class="container section section-tight project-intents" aria-labelledby="project-intents-heading">
  <header class="project-intents-heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="project-intents-heading">{copy.title}</h2>
    <p>{copy.intro}</p>
  </header>
  <div class="project-intents-grid">
    {copy.cases.map((item,i)=><article class="project-intent-card">
      <span class="project-intent-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
      <h3>{item.situation}</h3>
      <p>{item.explanation}</p>
      <p class="project-intent-request"><strong>{copy.request}:</strong> {item.request}</p>
      <a class="project-intent-link" href={prefix+'/bauleistungen/'+item.slug+'/'}>
        {copy.link}<span aria-hidden="true"> →</span>
      </a>
    </article>)}
  </div>
  <p class="project-intents-note">{copy.note}</p>
</section>
<style>
.project-intents{border-top:1px solid #dce7df;padding-block:clamp(40px,6vw,76px)}
.project-intents-heading{max-width:78ch;margin-bottom:28px}
.project-intents-heading h2{color:#0d343d;font-size:clamp(27px,3.5vw,44px);line-height:1.14;letter-spacing:-.035em;margin:12px 0 17px;text-wrap:balance}
.project-intents-heading>p:last-child{color:#47645d;font-size:16px;line-height:1.75;max-width:76ch}
.project-intents-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.project-intent-card{display:flex;flex-direction:column;min-width:0;padding:clamp(22px,3vw,32px);border:1px solid #d7e6dd;border-radius:20px;background:#edf6f0;color:#173d42}
.project-intent-card:nth-child(2){background:#edf3f8;border-color:#d8e4ea}
.project-intent-card:nth-child(3){background:#f8f2e8;border-color:#e9dfcf}
.project-intent-card:nth-child(4){background:#f2f0f9;border-color:#e4dff0}
.project-intent-number{font-size:13px;font-weight:800;color:#0d7775;letter-spacing:.08em}
.project-intent-card h3{font-size:clamp(20px,2.2vw,26px);line-height:1.25;letter-spacing:-.025em;margin:16px 0 12px;overflow-wrap:anywhere}
.project-intent-card>p{font-size:15px;line-height:1.7;color:#425e58;margin:0 0 16px;overflow-wrap:anywhere}
.project-intent-card .project-intent-request{border-top:1px solid #cddfd6;padding-top:15px;margin-top:auto}
.project-intent-request strong{color:#173d42}
.project-intent-link{display:inline-flex;align-items:center;align-self:flex-start;min-height:44px;color:#0b6367;font-size:15px;font-weight:800;text-underline-offset:5px;overflow-wrap:anywhere}
.project-intent-link:hover{text-decoration-thickness:2px}
.project-intent-link:focus-visible{outline:3px solid #07666a;outline-offset:5px;border-radius:3px}
.project-intents-note{margin:21px 0 0;color:#59736c;font-size:13px;line-height:1.65;max-width:90ch}
@media(max-width:700px){.project-intents-grid{grid-template-columns:1fr}.project-intent-card{padding:24px}.project-intents-heading{margin-bottom:20px}}
</style>
