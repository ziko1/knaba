---
import Layout from '../layouts/Layout.astro';
import {company} from '../data/company';
import {constructionBusinessCopy as c} from '../data/construction-offers';
import type {ConstructionLocale} from '../data/construction-offers';
import {infoGuidance,guidanceCopy,type InfoVariant} from '../data/construction-guidance';
import {constructionGuides} from '../data/construction-guides';
const {locale='de',variant}=Astro.props as {locale:ConstructionLocale,variant:InfoVariant};
const prefix=locale==='de'?'':'/'+locale;
const blocks={
 de:{
  branchen:{label:'B2B / BRANCHEN',title:'Für Bauunternehmen. Für Bauträger. Für Ihre Baustelle.',lead:'Unsere Arbeit folgt den Bauphasen, der Baustellenorganisation und Ihrer abgestimmten Leistungsbeschreibung.',items:[['Generalunternehmer & Bauunternehmen','Baubegleitende Reinigung und Bauhelfer nach Leistungsvereinbarung.'],['Bauträger & Projektsteuerung','Baufein- und Endreinigung vor Abnahme oder Objektübergabe.'],['Sanierung & Modernisierung','Baustaub, Zwischenreinigung und materialgerechte Arbeiten nach Umbau.'],['Fachunternehmen & Nachunternehmer','Ergänzende Arbeiten nach klarer Abgrenzung von Gewerk, Qualifikation und Verantwortung.'],['Immobilien & Bauverwaltung','Saubere Übergabe von Neubau-, Umbau- und Sanierungsobjekten.'],['Technische Gewerke','Bohrungen und Durchführungen ausschließlich nach fachlicher Prüfung und gesonderter Beauftragung.']]},
  unternehmen:{label:'ÜBER KNABA',title:'Baureinigung ist unser Schwerpunkt.',lead:'KnaBa aus Berlin verbindet Baureinigung, Baustellenvorbereitung und Bauhilfsarbeiten. Wir sprechen direkt über Bauabschnitt, Objekt und benötigte Leistung.',items:[['Klarer Leistungsumfang','Wir besprechen Flächen, Bauphase, Zugänglichkeit und Ausschlüsse.'],['Zusammenarbeit mit Firmen','Einsätze und Bauhelferleistungen werden auf Verträge und konkrete Projekte abgestimmt.'],['Sicherheit vor Ausführung','Bei Spezialarbeiten sind Genehmigungen, Qualifikation und verantwortliche Fachunternehmen vorab zu klären.']]},
  berlin:{label:'BERLIN & BRANDENBURG',title:'Baureinigung für Bauprojekte in Ihrer Region.',lead:'KnaBa ist in Berlin ansässig. Projektstandort, Erreichbarkeit und Termine in Berlin oder Brandenburg werden vor einer Beauftragung abgestimmt.',items:[['Neubau','Zwischen-, Fein- und Endreinigung passend zum Baufortschritt.'],['Umbau & Sanierung','Baustaub, Beräumung und Arbeiten in definierten Bauabschnitten.'],['B2B-Bauunterstützung','Bauhelfer und Zusatzleistungen nach Umfang, Vertrag und technischer Prüfung.']]},
  karriere:{label:'KARRIERE',title:'Bei KnaBa auf der Baustelle mitarbeiten.',lead:'Sie interessieren sich für Baureinigung, Baufeinreinigung oder Bauhelfer-Aufgaben? Fragen Sie nach aktuellen Möglichkeiten. Diese Seite stellt keine unbestätigten Stellenangebote dar.',items:[['Baureinigung','Sorgfältige Reinigung und Nachkontrolle nach Bauarbeiten.'],['Bauhelfer','Unterstützung auf Baustellen im vereinbarten Tätigkeitsbereich.'],['Kontakt','Bewerbung und Verfügbarkeit direkt mit KnaBa besprechen.']]},
  ratgeber:{label:'WISSEN / BAU',title:'Besser geplant. Sauber übergeben.',lead:'Praktische Informationen für Bauunternehmen und Bauherren: Abstimmung der Reinigungsphasen, Baustellenvorbereitung und sichere Spezialanfragen.',items:[['Baugrob- und Bauzwischenreinigung','Bauabschnitte, Staubquellen, Arbeitswege, Zugang und Wasser im Vorfeld klären.'],['Baufein- und Bauendreinigung','Abnahmetermin, empfindliche Materialien, Klebereste und verbleibende Gewerke abstimmen.'],['Kernbohrungen anfragen','Material, Bohrdurchmesser, statische Freigabe und Leitungslage vor Ausführung prüfen.']]},
 },
 en:{
  branchen:{label:'INDUSTRIES / B2B',title:'Built around construction projects.',lead:'Support for construction companies, developers, specialist trades and project managers.',items:[['General contractors','Construction cleaning and agreed auxiliary tasks.'],['Developers and project managers','Final cleaning before inspection and handover.'],['Renovation projects','Dust removal and planned interim cleaning.'],['Specialist subcontractors','Defined contractual support with clear responsibilities.'],['Property projects','Clean handover of newly built or renovated sites.'],['Technical installations','Service openings subject to checks and separate contracting.']]},
  unternehmen:{label:'ABOUT KNABA',title:'Construction cleaning is our focus.',lead:'KnaBa is based in Berlin. We help prepare building sites, clean up at different stages and provide agreed auxiliary work.',items:[['Clear scope','We discuss site size, phase, access and exclusions.'],['For business clients','Site support defined in contracts.'],['Safety first','Qualified contractors and required approvals are verified for specialist work.']]},
  berlin:{label:'BERLIN & BRANDENBURG',title:'Construction cleaning across your region.',lead:'KnaBa is based in Berlin. Exact availability, location and timing are agreed individually.',items:[['New builds','Interim and final construction cleaning.'],['Renovation','Dust removal and phase-specific cleaning.'],['B2B support','Contracted site support and assessed extras.']]},
  karriere:{label:'CAREERS',title:'Work on construction sites with KnaBa.',lead:'Interested in construction cleaning and auxiliary site work? Please ask about current opportunities; no vacancies are guaranteed here.',items:[['Site cleaning','Detailed cleaning and final checks.'],['Site support','Auxiliary activities by agreement.'],['Get in touch','Send your application to KnaBa directly.']]},
  ratgeber:{label:'CONSTRUCTION GUIDES',title:'Prepare better. Handover cleaner.',lead:'Practical project questions concerning site cleaning, handover and specialised requests.',items:[['Rough and interim cleaning','Specify construction phase and site utilities.'],['Fine and final cleaning','Agree sensitive surfaces and acceptance date.'],['Core drilling enquiries','Identify structure, utility routes and required approvals.']]}
 },
 uk:{
  branchen:{label:'ГАЛУЗІ / B2B',title:'Для будівельних компаній і забудовників.',lead:'Допомагаємо на об’єктах будівництва, ремонту та реконструкції за погодженим обсягом.',items:[['Генеральні підрядники','Міжетапний клінінг та будівельні помічники.'],['Забудовники','Фінальне прибирання перед прийманням.'],['Ремонт і реконструкція','Пил та залишки після робіт.'],['Субпідрядники','Допоміжні завдання з розмежуванням відповідальності.'],['Управління об’єктами','Чиста здача нових і відремонтованих приміщень.'],['Інженерні підрядники','Проходки після технічної перевірки й окремого договору.']]},
  unternehmen:{label:'ПРО KNABA',title:'Наша спеціалізація — будівельний клінінг.',lead:'KnaBa працює в Берліні. Узгоджуємо підготовку майданчика, прибирання за етапами та допоміжні роботи.',items:[['Чіткий обсяг','Обговорюємо об’єкт, терміни, доступ і винятки.'],['Контракти B2B','Виконання робіт за домовленістю з компаніями.'],['Безпека','Спеціальні роботи лише після перевірки дозволів і виконавця.']]},
  berlin:{label:'БЕРЛІН І БРАНДЕНБУРГ',title:'Будівельний клінінг у вашому регіоні.',lead:'KnaBa розташована в Берліні. Доступність, місце та строки уточнюємо для кожного проєкту.',items:[['Новобудови','Міжетапне та фінальне прибирання.'],['Реконструкція','Пил та залишки після окремих етапів.'],['B2B-підтримка','Помічники та додаткові роботи за договором.']]},
  karriere:{label:'КАР’ЄРА',title:'Працюйте на будівельних об’єктах із KnaBa.',lead:'Цікавить будівельний клінінг чи робота помічником? Уточніть актуальні вакансії напряму; відкриті позиції тут не гарантуються.',items:[['Клінінг після будівництва','Очищення і контроль якості.'],['Помічник на об’єкті','Допомога в межах погоджених завдань.'],['Зв’язок','Надішліть резюме до KnaBa.']]},
  ratgeber:{label:'ПОРАДИ / БУДІВНИЦТВО',title:'Краще планування — чистіша здача.',lead:'Корисні чеклісти щодо клінінгу, етапів робіт і спеціальних запитів.',items:[['Грубе й міжетапне прибирання','Узгодьте етапи, доступ і джерела пилу.'],['Тонке й фінальне прибирання','Перевірте поверхні та дату здачі.'],['Буріння бетону','Перевірте плани, конструкцію, комунікації та дозволи.']]}
 },
 ru:{
  branchen:{label:'ОТРАСЛИ / B2B',title:'Для строительных фирм и застройщиков.',lead:'Помощь на стройках, ремонтах и объектах реконструкции в согласованном объёме.',items:[['Генподрядчики','Промежуточный клининг и строительные помощники.'],['Застройщики','Финальная уборка перед приёмкой.'],['Ремонт и реконструкция','Уборка пыли и остатков по этапам.'],['Субподрядчики','Подсобные задачи с разграничением ответственности.'],['Управление объектами','Чистая сдача новых и отремонтированных зданий.'],['Инженерные подрядчики','Проходки после технической проверки и отдельного договора.']]},
  unternehmen:{label:'О KNABA',title:'Наша специализация — строительный клининг.',lead:'KnaBa работает в Берлине. Согласуем подготовку площадок, уборку по этапам и подсобные работы.',items:[['Понятный объём','Обсуждаем объект, сроки, доступ и исключения.'],['Контракты B2B','Поддержка фирм по индивидуальному договору.'],['Безопасность','Специальные работы только после проверки разрешений и исполнителя.']]},
  berlin:{label:'БЕРЛИН И БРАНДЕНБУРГ',title:'Строительный клининг в вашем регионе.',lead:'KnaBa находится в Берлине. Доступность, место и сроки уточняются по каждому проекту.',items:[['Новостройки','Промежуточная и финальная уборка.'],['Реконструкция','Пыль и остатки после отдельных этапов.'],['B2B поддержка','Помощники и дополнительные работы по договору.']]},
  karriere:{label:'КАРЬЕРА',title:'Работа на строительных объектах с KnaBa.',lead:'Интересует строительный клининг или работа помощником? Уточните актуальные вакансии напрямую. Открытые места здесь не гарантируются.',items:[['Уборка стройки','Очистка и контроль качества.'],['Помощник','Вспомогательные работы по договорённости.'],['Контакт','Отправьте резюме в KnaBa.']]},
  ratgeber:{label:'СОВЕТЫ / СТРОИТЕЛЬСТВО',title:'Лучше план — чище сдача.',lead:'Чеклисты по уборке объектов, этапам и специальным запросам.',items:[['Черновая и промежуточная уборка','Уточните этапы, доступ и источники пыли.'],['Тонкая и финальная уборка','Проверьте поверхности и дату сдачи.'],['Бурение бетона','Проверьте чертежи, конструкцию, коммуникации и разрешения.']]}
 }
} as const;
const t=blocks[locale][variant];const cta=c[locale];
const guidance=infoGuidance[variant];
---
<Layout lang={locale} title={t.title+' | KnaBa'} description={t.lead}>
<section class="container page-intro"><p class="eyebrow">{t.label}</p><h1>{t.title}</h1><p>{t.lead}</p></section>
{variant!=='ratgeber' && <section class="container section section-tight"><div class="bau-info-grid">{t.items.map(([title,body],i)=><article class="bau-info-card"><span class="bau-info-number">0{i+1}</span><h2>{title}</h2><p>{body}</p><a class="text-link" href={prefix+'/kontakt/'}>{cta.cta} →</a></article>)}</div></section>}
<section class="container section section-tight bau-guidance" aria-labelledby="guidance-title">
  <div class="bau-guidance-heading"><h2 id="guidance-title">{guidance.heading[locale]}</h2><p>{guidance.intro[locale]}</p></div>
  {variant==='ratgeber' && <nav class="bau-guide-contents" aria-label={guidanceCopy.contents[locale]}>
    {guidance.sections.map((section,i)=><a href={'#guide-section-'+(i+1)}>{section.title[locale]}</a>)}
  </nav>}
  <div class="bau-guidance-grid">
    {guidance.sections.map((section,i)=><article class="bau-guidance-section" id={'guide-section-'+(i+1)}>
      <h3>{section.title[locale]}</h3><ul>{section.items.map(item=><li>{item[locale]}</li>)}</ul>
    </article>)}
  </div>
  <nav class="bau-related" aria-label={guidanceCopy.related[locale]}>
    <p>{guidanceCopy.related[locale]}</p><ul>{guidance.links.map(link=><li><a href={prefix+link.path}>{link.label[locale]} <span aria-hidden="true">↗</span></a></li>)}</ul>
  </nav>
</section>
{variant==='ratgeber' && <section class="container section section-tight" aria-labelledby="published-guide-heading">
  <div class="bau-guidance-heading">
    <h2 id="published-guide-heading">{locale==='de'?'Vertiefende Bau-Ratgeber':locale==='en'?'Detailed construction guides':locale==='uk'?'Докладні порадники з будівельного клінінгу':'Подробные руководства по строительному клинингу'}</h2>
    <p>{locale==='de'?'Vier praktische Artikel zur Vorbereitung, Kostenplanung und Abnahme. Kein verbindliches Preis- oder Leistungsversprechen.':locale==='en'?'Four practical articles on stages, quotes, preparation and handover. No fixed pricing or service commitment.':locale==='uk'?'Чотири практичні матеріали про етапи, кошториси, підготовку й здачу об’єкта. Без фіксованих цін чи гарантій послуг.':'Четыре практических материала об этапах, сметах, подготовке и сдаче объекта. Без фиксированных цен и гарантий услуг.'}</p>
  </div>
  <div class="bau-editorial-guides">
  {constructionGuides.map((item,index)=><a class="bau-editorial-guide" href={prefix+'/ratgeber/'+item.slug+'/'}>
    <span aria-hidden="true">{String(index+1).padStart(2,'0')} / KNABA</span>
    <h3>{item.title[locale]}</h3>
    <p>{item.description[locale]}</p>
    <span aria-hidden="true">↗</span>
  </a>)}
  </div>
</section>}
<section class="container cta-banner"><div><p class="eyebrow">{cta.region}</p><h2>{cta.ready}</h2><p>{cta.note}</p></div><a class="button button-dark" href={prefix+'/kontakt/'}>{cta.cta} ↗</a></section>
<section class="container section section-tight"><p><strong>KnaBa</strong> · {company.street}, {company.city} · <a href={company.phoneHref}>{company.phone}</a> · <a href={'mailto:'+company.email}>{company.email}</a></p></section>
</Layout>
<style>
.bau-info-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.bau-info-card{background:#ebf5ed;padding:32px 28px;border:1px solid #d6e9de;border-radius:20px;display:flex;flex-direction:column;min-height:255px}.bau-info-card:nth-child(even){background:#e7f2f5}.bau-info-card h2{font-size:23px;line-height:1.15;margin:22px 0 10px}.bau-info-card p{font-size:14px;line-height:1.65;color:#48665e}.bau-info-card a{margin-top:auto}.bau-info-number{font-size:15px;color:#0a8c92;font-weight:850}
.bau-guidance-heading{max-width:78ch;margin-bottom:26px}.bau-guidance-heading h2{font-size:clamp(26px,3vw,40px);line-height:1.16;letter-spacing:-.035em;overflow-wrap:anywhere}.bau-guidance-heading p{color:#48665e;line-height:1.75}
.bau-guide-contents{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 28px}.bau-guide-contents a{display:flex;align-items:center;min-height:44px;padding:10px 15px;border:1px solid #b9d4c9;border-radius:12px;color:#164d50;font-size:14px;font-weight:700;text-decoration:none;max-width:100%;overflow-wrap:anywhere}
.bau-guidance-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.bau-guidance-section{min-width:0;padding:clamp(22px,3vw,34px);border:1px solid #cddfd6;border-radius:20px;background:#f3f8f2;scroll-margin-top:110px}.bau-guidance-section:nth-child(even){background:#edf5f6}.bau-guidance-section h3{font-size:22px;line-height:1.3;letter-spacing:-.02em;margin:0 0 20px;overflow-wrap:anywhere}.bau-guidance-section ul{margin:0;padding-left:20px;display:grid;gap:16px}.bau-guidance-section li{color:#3c5c55;font-size:15px;line-height:1.75;overflow-wrap:anywhere;padding-left:4px}.bau-guidance-section li::marker{color:#187972}
.bau-related{padding-top:26px}.bau-related p{font-weight:800;color:#143d41}.bau-related ul{list-style:none;margin:0;padding:0;display:flex;gap:10px 22px;flex-wrap:wrap}.bau-related a{display:inline-flex;align-items:center;gap:8px;min-height:44px;color:#126b6d;font-weight:700;text-underline-offset:5px;overflow-wrap:anywhere}.bau-related a:focus-visible,.bau-guide-contents a:focus-visible{outline:3px solid #137a7a;outline-offset:4px;border-radius:5px}.bau-guide-contents a:hover{background:#e2f0e5}
@media(max-width:760px){.bau-guidance-grid{grid-template-columns:1fr}.bau-guide-contents{display:grid}.bau-guidance-section{scroll-margin-top:90px}}
@media(max-width:870px){.bau-info-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.bau-info-grid{grid-template-columns:1fr}.bau-info-card{min-height:210px}}

.bau-editorial-guides{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.bau-editorial-guide{display:flex;flex-direction:column;min-height:250px;padding:clamp(22px,3vw,34px);background:linear-gradient(135deg,#d1eff0,#eef9e9);border:1px solid #d5e4dd;border-radius:22px;text-decoration:none;color:#183c43;min-width:0}
.bau-editorial-guide:nth-child(2){background:linear-gradient(135deg,#f6dcc5,#fff1d9)}
.bau-editorial-guide:nth-child(3){background:linear-gradient(135deg,#e8dffd,#f5edfb)}
.bau-editorial-guide:nth-child(4){background:linear-gradient(135deg,#d8ebd7,#eaf5e1)}
.bau-editorial-guide>span:first-child{font-size:12px;font-weight:850;color:#226166}
.bau-editorial-guide h3{font-size:clamp(20px,2.2vw,29px);line-height:1.2;margin:19px 0 12px;overflow-wrap:anywhere}
.bau-editorial-guide p{font-size:14px;line-height:1.65;color:#355953;margin:0 0 15px;overflow-wrap:anywhere}
.bau-editorial-guide>span:last-child{align-self:flex-end;margin-top:auto;font-size:22px}
.bau-editorial-guide:focus-visible{outline:3px solid #176873;outline-offset:4px}
@media(max-width:700px){.bau-editorial-guides{grid-template-columns:1fr}.bau-editorial-guide{min-height:210px}}
</style>
