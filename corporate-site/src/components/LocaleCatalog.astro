---
import type {PublishedSiteLocale} from '../lib/locale-catalog';
const {locale='de'}=Astro.props as {locale?:PublishedSiteLocale};
const messages={
  de:{heading:'99 Zielsprachen',search:'Sprache suchen',summary:'4 veröffentlicht · 95 geplant',pending:'Weitere Zielsprachen',note:'Noch nicht übersetzte Sprachen sind nicht auswählbar. Unübersetzte Seiten werden nicht als Übersetzung ausgezeichnet.',empty:'Keine passende Sprache',soon:'Geplant',loading:'Sprachen werden geladen …',error:'Sprachenliste nicht verfügbar. Die vier veröffentlichten Sprachen oben funktionieren weiter.',idle:'Weitere Sprachen werden erst beim Öffnen geladen.'},
  en:{heading:'99 target languages',search:'Find a language',summary:'4 published · 95 planned',pending:'Additional target languages',note:'Languages awaiting translation cannot be selected. Untranslated pages are never labelled as translations.',empty:'No matching language',soon:'Planned',loading:'Loading language list …',error:'Language list is unavailable. The four published languages above still work.',idle:'More languages load only when you open this menu.'},
  uk:{heading:'99 цільових мов',search:'Знайти мову',summary:'4 опубліковано · 95 заплановано',pending:'Інші цільові мови',note:'Мови без готового перекладу поки не можна вибрати. Неперекладений вміст не видаємо за переклад.',empty:'Мову не знайдено',soon:'У плані',loading:'Завантаження мов …',error:'Список мов недоступний. Чотири опубліковані мови вище продовжують працювати.',idle:'Додаткові мови завантажуються лише після відкриття меню.'},
  ru:{heading:'99 целевых языков',search:'Найти язык',summary:'4 опубликовано · 95 запланировано',pending:'Другие целевые языки',note:'Пока перевод не готов, язык нельзя выбрать. Непереведённые страницы не выдаются за перевод.',empty:'Язык не найден',soon:'В плане',loading:'Загрузка языков …',error:'Список языков недоступен. Четыре опубликованных языка выше продолжают работать.',idle:'Другие языки загружаются только после открытия меню.'}
} as const;
const t=messages[locale];
---
<section data-locale-catalog class="locale-catalog" data-soon={t.soon} data-error={t.error} data-loading={t.loading} aria-label={t.heading}>
  <div class="locale-catalog-heading"><strong>{t.heading}</strong><small>{t.summary}</small></div>
  <label class="locale-catalog-search"><span>{t.search}</span><input type="search" autocomplete="off" data-locale-search placeholder={t.search} aria-controls="knaba-pending-languages" /></label>
  <ul class="locale-catalog-list" id="knaba-pending-languages" hidden aria-label={t.pending} data-locale-list></ul>
  <p class="locale-catalog-empty" hidden data-locale-empty role="status">{t.empty}</p>
  <p class="locale-catalog-status" data-locale-status role="status" aria-live="polite">{t.idle}</p>
  <p class="locale-catalog-note">{t.note}</p>
</section>
<script>
function bindLocaleCatalog() {
  for(const root of document.querySelectorAll<HTMLElement>('[data-locale-catalog]')) {
    const input=root.querySelector<HTMLInputElement>('[data-locale-search]');
    const empty=root.querySelector<HTMLElement>('[data-locale-empty]');
    const list=root.querySelector<HTMLUListElement>('[data-locale-list]');
    const status=root.querySelector<HTMLElement>('[data-locale-status]');
    const disclosure=root.closest('details');
    if(!input||!empty||!list||!status||!disclosure||root.dataset.bound==='1')continue;
    root.dataset.bound='1';
    let loading=false,loaded=false;
    const filter=()=>{
      const q=input.value.trim().toLocaleLowerCase();
      let count=0;
      for(const item of list.querySelectorAll<HTMLElement>('[data-locale-item]')){
        const visible=(item.dataset.search||'').includes(q);
        item.hidden=!visible;
        if(visible)count+=1;
      }
      empty.hidden=count!==0;
    };
    input.addEventListener('input',filter);
    // Search inputs may consume Escape natively; always let keyboard users
    // dismiss the disclosure and regain focus on its trigger.
    input.addEventListener('keydown',(event)=>{
      if(event.key!=='Escape')return;
      event.preventDefault();
      event.stopPropagation();
      input.value='';
      filter();
      disclosure.open=false;
      disclosure.querySelector<HTMLElement>('summary')?.focus();
    });
    const load=async()=>{
      if(loaded||loading)return;
      loading=true;
      list.setAttribute('aria-busy','true');
      status.hidden=false;
      status.textContent=root.dataset.loading||'';
      try{
        // This endpoint contains only approved static BCP47 metadata, no customer data.
        const result=await fetch('/languages.json',{credentials:'omit',cache:'force-cache'});
        if(!result.ok)throw new Error('Locale manifest unavailable');
        const data:unknown=await result.json();
        if(!data||typeof data!=='object')throw new Error('Invalid locale manifest');
        const manifest=data as {targets?:number;published?:number;pending?:number;locales?:unknown};
        if(manifest.targets!==99||manifest.published!==4||manifest.pending!==95||!Array.isArray(manifest.locales)||manifest.locales.length!==99)
          throw new Error('Unexpected locale manifest');
        const pending=manifest.locales.filter((entry:unknown)=>{
          return !!entry&&typeof entry==='object'&&(entry as {status?:unknown}).status==='pending';
        });
        if(pending.length!==95)throw new Error('Incorrect translation readiness');
        const fragment=document.createDocumentFragment();
        for(const entry of pending) {
          const item=entry as {code?:unknown;label?:unknown;direction?:unknown};
          if(typeof item.code!=='string'||!(/^[a-z]{2,3}(?:-[A-Z][a-z]{3})?$/.test(item.code))||
             typeof item.label!=='string'||item.label.length>90)throw new Error('Invalid locale entry');
          let native=item.label;
          try{native=new Intl.DisplayNames([item.code],{type:'language'}).of(item.code)||native;}catch{/* English fallback */}
          const li=document.createElement('li');
          li.dataset.localeItem='1';
          li.dataset.search=(native+' '+item.label+' '+item.code).toLocaleLowerCase();
          const name=document.createElement('span');
          name.lang=item.code;
          name.dir=item.direction==='rtl'?'rtl':'ltr';
          name.textContent=native;
          const code=document.createElement('span');
          code.className='locale-catalog-code';
          code.textContent=item.code;
          const planned=document.createElement('span');
          planned.className='locale-catalog-pending';
          planned.textContent=root.dataset.soon||'';
          li.append(name,code,planned);
          fragment.append(li);
        }
        if(!root.isConnected)return;
        list.append(fragment);
        list.hidden=false;
        loaded=true;
        status.hidden=true;
        filter();
      }catch{
        if(root.isConnected)status.textContent=root.dataset.error||'Language list unavailable';
      }finally{
        loading=false;
        list.removeAttribute('aria-busy');
      }
    };
    disclosure.addEventListener('toggle',()=>{if(disclosure.open)void load();});
    if(disclosure.open)void load();
  }
}
bindLocaleCatalog();
document.addEventListener('astro:page-load',bindLocaleCatalog);
</script>
<style>
.locale-catalog{border-top:1px solid #d7e4da;margin:4px 0 0;padding:12px 8px 5px;color:#23483f}
.locale-catalog-heading{display:grid;gap:5px;margin:0 0 12px}
.locale-catalog-heading strong{font-size:.91rem;color:#143d32}
.locale-catalog-heading small{font-size:.73rem;color:#5b7168}
.locale-catalog-search{display:grid;gap:5px;font-size:.76rem;font-weight:700;margin-bottom:9px}
.locale-catalog-search input{min-height:44px;width:100%;padding:8px 12px;border:1px solid #aebfb5;border-radius:10px;color:#103c33;background:#fff;font-size:16px}
.locale-catalog-search input:focus-visible{outline:3px solid #8fcaa5;outline-offset:2px}
.locale-catalog-list{margin:0;padding:0;list-style:none;max-height:188px;overflow-y:auto;overscroll-behavior:contain;border-top:1px solid #ebf0ec}
.locale-catalog-list[hidden],.locale-catalog-list li[hidden],.locale-catalog-empty[hidden],.locale-catalog-status[hidden]{display:none}
.locale-catalog-list li{display:flex;gap:8px;align-items:center;padding:9px 3px;min-height:34px;color:#526a5e;border-bottom:1px solid #edf1ee;font-size:.79rem}
.locale-catalog-list li>span:first-child{min-width:0;flex:1;overflow-wrap:anywhere}
.locale-catalog-code{color:#778b7e;font-size:.65rem;text-transform:uppercase}
.locale-catalog-pending{color:#556b61;border-radius:6px;background:#edf3ed;font-size:.64rem;white-space:nowrap;padding:3px 6px}
.locale-catalog-status{font-size:.72rem;color:#496963;line-height:1.4;margin:10px 0}
.locale-catalog-note{margin:11px 0 0;font-size:.71rem;line-height:1.48;color:#547168}
.locale-catalog-empty{margin:12px 0;font-size:.8rem;color:#79522d}
</style>
