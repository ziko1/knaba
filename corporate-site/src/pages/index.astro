---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { services, company } from "../data/company";
const faqs = [
  ["Welche Reinigung passt zu meinem Objekt?", "Ob Büro, Treppenhaus oder Bauprojekt: Unser Reinigungsplaner hilft Ihnen, passende Leistungen auszuwählen. Den genauen Umfang stimmen wir anschließend gemeinsam ab."],
  ["Was kostet eine Reinigung?", "Fläche, Zustand, Zugänglichkeit und Häufigkeit bestimmen den Aufwand. Sie erhalten ein individuelles Angebot auf Basis Ihres Objekts."],
  ["Ist auch eine regelmäßige Reinigung möglich?", "Ja. Für die Unterhaltsreinigung vereinbaren wir die gewünschten Arbeiten und einen passenden Rhythmus. Betriebszeiten und Zugang besprechen wir mit Ihnen."],
  ["In welcher Region arbeitet KnaBa?", "Wir bieten Gebäudereinigung in Berlin und Brandenburg an. Ob und wie wir Ihr konkretes Objekt betreuen können, klären wir im persönlichen Gespräch."],
];
---
<Layout alternates={[{lang:"de",url:"/"},{lang:"en",url:"/en/"},{lang:"uk",url:"/uk/"},{lang:"x-default",url:"/"}]} schema={{"@type":"FAQPage",mainEntity:faqs.map(([question,answer])=>({"@type":"Question",name:question,acceptedAnswer:{"@type":"Answer",text:answer}}))}} title="Gebäudereinigung Berlin | KnaBa für Büro & Immobilien" description="Saubere Räume. Klare Sache. KnaBa Gebäudereinigung für Büros, Immobilien und Bauprojekte in Berlin und Brandenburg. Jetzt Ihren Reinigungsbedarf planen.">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="hero-pill"><span class="dot"></span> GEBÄUDEREINIGUNG · BERLIN & BRANDENBURG</span></p>
      <h1>Saubere Räume.<br /><span class="hero-highlight">Klare Sache.</span><span class="hero-spark" aria-hidden="true">✳</span></h1>
      <p class="hero-description">Mehr Raum für das, was zählt.<br />Gebäudereinigung für Unternehmen, Immobilien und Bauprojekte. Persönlich abgestimmt. Bis ins Detail.</p>
      <div class="hero-actions"><a class="button button-dark" href="/planer/">Reinigungsplan erstellen <Icon size={20} /></a><a class="text-link" href="/leistungen/">Leistungen entdecken <Icon name="diagonal" size={18} /></a></div>
      <div class="hero-notes"><span><Icon name="check" size={17} /> Individuell für Ihr Objekt</span><span><Icon name="check" size={17} /> Direkter Kontakt</span></div>
    </div>
    <div class="hero-art">
      <div class="art-caption"><span class="tiny-cross" aria-hidden="true">✳</span> PLATZ FÜR EIN GUTES GEFÜHL.</div>
      <svg class="office-art" viewBox="0 0 600 560" role="img" aria-label="Illustration eines gepflegten, hellen Büros mit großen Fenstern und Pflanzen">
        <defs><clipPath id="office-window"><path d="M104 124a102 102 0 0 1 204 0v212H104z" /></clipPath><linearGradient id="office-sky" x2="0" y2="1"><stop stop-color="#b4e2f4"/><stop offset="1" stop-color="#f4fbf8"/></linearGradient></defs>
        <path d="M52 62H548V434H52z" fill="#f4f7ea"/><path d="M52 434H548L596 534H3z" fill="#bbd6c4"/>
        <path d="M104 124a102 102 0 0 1 204 0v212H104z" fill="url(#office-sky)"/>
        <g clip-path="url(#office-window)"><path d="M102 265 152 228l48 29 55-83 56 41v121H102z" fill="#a2c9b1"/><path d="M87 317 170 272l53 28 60-51 43 31v65H87z" fill="#669c8b"/><circle cx="257" cy="107" r="28" fill="#fff9bf"/></g>
        <path d="M104 124a102 102 0 0 1 204 0v212H104zM206 23v313M105 175h198" fill="none" stroke="#123943" stroke-width="9"/><path d="M88 338h235" stroke="#123943" stroke-width="12"/>
        <path d="m64 478 113-34 315 1 62 61-359 8z" fill="#a6c5b3"/>
        <path d="M192 350h270v20H192z" fill="#173d46"/><path d="M216 370h12v125h-12zM431 370h12v125h-12z" fill="#173d46"/><path d="m228 370 203 37v10l-203-37z" fill="#335d63"/>
        <rect x="274" y="269" width="112" height="73" rx="5" fill="#203e4a"/><rect x="281" y="276" width="98" height="57" rx="2" fill="#d0c9fa"/><path d="M309 342h41v8h-41z" fill="#203e4a"/><path d="M292 288h39M292 298h54M292 308h22" stroke="#fff" stroke-width="4"/>
        <rect x="401" y="325" width="23" height="25" rx="3" fill="#e28967"/><path d="M424 330h6c9 0 9 13 0 13h-6" fill="none" stroke="#e28967" stroke-width="4"/>
        <path d="M350 391c0-26-17-42-43-42h-32c-24 0-39 16-39 40v47h114z" fill="#ec927b"/><path d="M237 431h113v22H237z" fill="#c56957"/><path d="M259 453v53M328 453v53" stroke="#163a43" stroke-width="10"/><path d="M247 431v-38c0-15 10-26 25-26h34c16 0 27 11 27 26v38" fill="none" stroke="#f3b19d" stroke-width="3"/>
        <path d="M476 408c-1-46 8-92 14-131" stroke="#255d46" stroke-width="6" fill="none"/><path d="M490 342c-38-2-57-24-47-45 25 3 41 19 47 45M487 367c35-6 56-32 43-50-25 7-39 24-43 50M488 307c-22-13-27-40-11-54 17 15 22 32 11 54M491 289c27-5 39-26 28-43-19 6-28 22-28 43" fill="#4b875b"/><path d="M461 403h54l-7 64h-40z" fill="#e6ad65"/><path d="M466 413h44" stroke="#c78c49" stroke-width="3"/>
        <rect x="366" y="136" width="99" height="119" rx="3" fill="#d8d6f2"/><rect x="375" y="145" width="81" height="101" fill="#eeebff"/><circle cx="413" cy="182" r="25" fill="#a69edb"/><path d="m381 234 32-48 37 48z" fill="#d3de85"/>
        <path d="M341 66h54M368 40v54M328 80h17M337 72v17" stroke="#e59475" stroke-width="5" stroke-linecap="round"/><path d="m149 380 4 13 13 4-13 4-4 13-4-13-13-4 13-4z" fill="#f6ffe7"/>
      </svg>
      <div class="art-tag"><span class="label-icon"><Icon name="sparkle" size={25}/></span><span><strong>Ihr Objekt. Unser Fokus.</strong><small>Ein passender Plan ist der Anfang.</small></span></div>
      <a class="art-round-link" href="/planer/" aria-label="Reinigungsplaner öffnen"><Icon name="diagonal" size={29}/></a>
      <span class="art-credit">ILLUSTRATION · KEIN REFERENZOBJEKT</span>
    </div>
  </section>
  <div class="trust-band"><div class="container"><span>SAUBERKEIT FÜR IHREN ALLTAG</span><a href="/branchen/">Büros & Gewerbe <span aria-hidden="true">↗</span></a><a href="/branchen/">Hausverwaltungen <span aria-hidden="true">↗</span></a><a href="/leistungen/baureinigung/">Bau & Immobilien <span aria-hidden="true">↗</span></a></div></div>

  <section class="section container section-tight" aria-labelledby="bauhilfe-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">AUCH AUF DER BAUSTELLE</p>
        <h2 id="bauhilfe-heading">Bauhelfer und<br />Bauhilfsleistungen.</h2>
      </div>
      <div>
        <p>Neben der Baureinigung nennt KnaBa in seinem offiziellen Angebot auch Bauhilfsarbeiten und Baustellenvorbereitung. Welche Arbeiten möglich sind, sowie Umfang und Preis klären wir persönlich.</p>
        <a class="text-link" href="/kontakt/">Bauhilfe anfragen <Icon name="diagonal" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section container" id="leistungen">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-dot"></span> WAS WIR FÜR SIE TUN</p><h2>Für jeden Raum<br />die richtige Lösung.</h2></div><div><p>Von der täglichen Pflege bis zum großen Abschluss.<br />Wählen Sie, was zu Ihrem Objekt passt.</p><a class="text-link" href="/leistungen/">Alle Leistungen <Icon size={18}/></a></div></div>
    <div class="service-grid">{services.map((s,i)=><a class="service-card" href={`/leistungen/${s.slug}/`}><div class="service-card-top"><span class="service-icon"><Icon name={s.icon} size={28}/></span><span class="service-number">0{i+1}</span></div><span class="eyebrow">{s.tag}</span><h3>{s.name}</h3><p>{s.description}</p><span class="service-card-bottom">Mehr erfahren <span class="card-arrow"><Icon name="diagonal" size={18}/></span></span></a>)}</div>
  </section>

  <section class="container planner-banner" aria-labelledby="plan-title"><div class="planner-copy"><p class="eyebrow">WENIGE KLICKS. MEHR KLARHEIT.</p><h2 id="plan-title">Ihr Objekt ist einzigartig.<br /><span>Ihr Reinigungsplan auch.</span></h2><p>Finden Sie die passende Leistung, bereiten Sie Ihr Gespräch vor und nehmen Sie Ihre Auswahl direkt in die Anfrage mit.</p><a href="/planer/" class="button button-dark">Reinigungsplan erstellen <Icon size={20}/></a><span class="planner-footnote">Ohne Anmeldung. Ohne Preisversprechen.</span></div><div class="plan-preview" aria-hidden="true"><div class="plan-preview-top"><span class="plan-mini-logo">K.</span><span>MEIN REINIGUNGSPLAN</span><span class="plan-preview-dot"></span></div><div class="plan-preview-title">Platz für Ihren Bedarf.</div><div class="plan-preview-row"><span class="plan-check">✓</span><div><strong>Das passende Objekt</strong><small>Büro, Immobilie oder Bauprojekt</small></div><span class="plan-step">01</span></div><div class="plan-preview-row"><span class="plan-check lilac">✓</span><div><strong>Ihre Leistung</strong><small>Gezielt auswählen und abstimmen</small></div><span class="plan-step">02</span></div><div class="plan-preview-row"><span class="plan-check coral">↗</span><div><strong>Bereit für das Gespräch</strong><small>Zusammenfassung für Ihre Anfrage</small></div><span class="plan-step">03</span></div></div></section>

  <section class="approach"><div class="container approach-grid"><div><p class="eyebrow">GUT GEREINIGT. GUT ORGANISIERT.</p><h2>Sie machen<br />Ihr Geschäft.<br /><span>Wir die Sauberkeit.</span></h2><p>Eine gute Reinigung beginnt mit dem Verstehen. Wir besprechen Ihre Räume, Ihre Abläufe und das Ergebnis, das Sie erwarten.</p><a href="/unternehmen/" class="text-link light">KnaBa kennenlernen <Icon size={19}/></a></div><div class="principles">{[["01","Ein Plan, der zu Ihnen passt","Leistungsumfang, Materialien und Reinigungsintervalle stimmen wir auf Ihr Objekt ab."],["02","Einfach miteinander sprechen","Direkter Kontakt und klare Absprachen — vom ersten Gespräch bis zur laufenden Abstimmung."],["03","In Ihrer Region zu Hause","Gebäudereinigung in Berlin und Brandenburg. Mit einem persönlichen Kontakt in Berlin."]].map(([n,t,d])=><div><span>{n}</span><div><h3>{t}</h3><p>{d}</p></div></div>)}</div></div></section>

  <section class="section container"><div class="section-heading"><div><p class="eyebrow"><span class="section-dot coral"></span> DER WEG ZUR ZUSAMMENARBEIT</p><h2>Unkompliziert.<br />Vom ersten Kontakt an.</h2></div><p>Ein klarer Ablauf. Ein gemeinsames Verständnis.<br />Und ein Angebot für Ihren tatsächlichen Bedarf.</p></div><div class="steps">{[["01","Bedarf beschreiben","Wählen Sie Ihre Leistung im Planer aus oder sprechen Sie direkt mit uns."],["02","Details abstimmen","Wir klären Umfang, Zugang und Termine. Bei Bedarf direkt vor Ort."],["03","Angebot vereinbaren","Sie erhalten ein individuelles Angebot. Der Start erfolgt nach gemeinsamer Abstimmung."]].map(([n,t,d])=><div><span>{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></section>

  <section class="container region-section"><div class="region-graphic" aria-hidden="true"><div class="map-grid"></div><div class="map-orbit orbit-one"></div><div class="map-orbit orbit-two"></div><div class="map-center"><span><Icon name="pin" size={25}/></span><strong>Berlin</strong><small>+ Brandenburg</small></div><span class="map-caption">NAH DRAN. PERSÖNLICH ERREICHBAR.</span></div><div class="region-copy"><p class="eyebrow">BERLIN & BRANDENBURG</p><h2>Für Ihre Räume.<br />In Ihrer Region.</h2><p>Vom Büro in der Stadt bis zur Immobilie im Umland: Besprechen Sie Ihren Standort und den gewünschten Leistungsumfang direkt mit uns.</p><a href={company.phoneHref} class="text-link"><Icon name="phone" size={18}/>{company.phone}</a></div></section>

  <section class="section container seo-story" aria-labelledby="berlin-cleaning"><div><p class="eyebrow">REINIGUNGSFIRMA IN BERLIN</p><h2 id="berlin-cleaning">Damit Ihr Objekt<br />einen guten Eindruck macht.</h2><p>Ein gepflegtes Büro erleichtert den Arbeitsalltag. Ein sauberes Treppenhaus heißt Bewohner und Gäste willkommen. Nach dem Bauen oder Renovieren schafft eine abgestimmte Endreinigung die Grundlage für die Übergabe. KnaBa verbindet diese Anforderungen mit einem persönlichen Blick auf Ihr Objekt.</p><p>Von unserem Standort in Berlin aus besprechen wir Reinigungsaufträge in der Stadt und im Brandenburger Umland. Sie nennen uns Standort, Fläche und Bedarf. Gemeinsam klären wir, welche Leistungen und Zeitfenster zu Ihrer Immobilie passen.</p><a href="/berlin/" class="text-link">Mehr zur Reinigung in Berlin →</a></div><div><h3>Was gehört in ein gutes Reinigungskonzept?</h3><ul><li>Eine klare Liste der Räume, Oberflächen und Aufgaben.</li><li>Ein passender Turnus für stark und weniger stark genutzte Bereiche.</li><li>Vereinbarte Zugangszeiten und ein verantwortungsvoller Umgang mit Schlüsseln.</li><li>Eine Abstimmung zu Materialien, Pflegehinweisen und besonderen Anforderungen.</li><li>Ein erreichbarer Kontakt für Rückfragen und Änderungen.</li></ul><p>Genau diese Punkte können Sie mit unserem <a href="/planer/">Reinigungsplaner</a> vorbereiten. Für eine Anfrage brauchen Sie kein Konto. Mit einem freigeschalteten Kundenkonto behalten Sie Ihre eigenen Vorgänge und deren Bearbeitungsstand im Blick.</p><a href="/konto/" class="text-link">Mein KnaBa kennenlernen →</a></div></section>
  <section class="container section" aria-labelledby="guide-home"><p class="eyebrow">WISSEN FÜR IHR OBJEKT</p><h2 id="guide-home">Besser vorbereitet.<br />Einfacher entscheiden.</h2><div class="guide-teasers"><article class="guide-teaser"><span class="eyebrow">PLANUNG</span><h3>Leistungen richtig abstimmen</h3><p>Welche Angaben helfen bei einem aussagekräftigen Reinigungsangebot? Unser Ratgeber erklärt, worauf es ankommt.</p><a href="/ratgeber/">Ratgeber entdecken →</a></article><article class="guide-teaser"><span class="eyebrow">REGELMÄSSIGE PFLEGE</span><h3>Ein Rhythmus für Ihren Alltag</h3><p>Nutzung, Besucheraufkommen und Bereiche bestimmen den Bedarf. So wird aus einzelnen Aufgaben ein klarer Reinigungsplan.</p><a href="/leistungen/unterhaltsreinigung/">Unterhaltsreinigung verstehen →</a></article><article class="guide-teaser"><span class="eyebrow">BAUPROJEKTE</span><h3>Gut vorbereitet zur Übergabe</h3><p>Grob-, Fein- und Endreinigung haben unterschiedliche Aufgaben. Klären Sie den Baufortschritt und den gewünschten Übergabezustand.</p><a href="/leistungen/baureinigung/">Baureinigung im Detail →</a></article></div></section>
  <section class="section container faq-section"><div><p class="eyebrow">GUT ZU WISSEN</p><h2>Ein paar Fragen.<br />Klare Antworten.</h2><p>Ihr Anliegen ist noch nicht dabei?</p><a href="/kontakt/" class="text-link">Sprechen wir darüber <Icon size={18}/></a></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
  <section class="container cta-banner"><div><p class="eyebrow">DER ERSTE SCHRITT IST GANZ EINFACH.</p><h2>Gute Räume.<br />Beginnen mit einem Gespräch.</h2></div><a class="button button-dark" href="/kontakt/">Jetzt Reinigung anfragen <Icon size={20}/></a></section>
</Layout>
