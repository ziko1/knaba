---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { sectors } from "../data/company";
---

<Layout
  title="Reinigung für Ihre Branche | KnaBa"
  description="Reinigungskonzepte für Unternehmen, Hausverwaltungen, Bauprojekte, Bildung, Handel und Pflege in Berlin und Brandenburg."
  ><section class="container page-intro">
    <p class="eyebrow">IHRE BRANCHE</p><h1>
      Andere Räume.<br /><span>Derselbe Anspruch.</span>
    </h1><p>
      Ein Büro hat andere Anforderungen als ein Treppenhaus oder eine Baustelle.
      Wir stimmen die Reinigung auf die Nutzung Ihres Objekts ab.
    </p>
  </section><section class="container section section-tight">
    <div class="sector-grid">
      {
        sectors.map(([t, d], i) => (
          <article>
            <>
              <span class="service-number">0{i + 1}</span>
              <h2>{t}</h2>
              <p>{d}</p>
              <a href="/kontakt/" class="text-link">
                Bedarf besprechen <Icon size={18} />
              </a>
            </>
          </article>
        ))
      }
    </div>
  </section><section class="container cta-banner">
    <div>
      <h2>Ihr Objekt ist besonders?<br />Lassen Sie uns darüber sprechen.</h2>
    </div><a href="/kontakt/" class="button button-dark"
      >Kontakt aufnehmen <Icon /></a>
  </section></Layout
>
