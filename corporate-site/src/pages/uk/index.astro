---
import Layout from "../../layouts/Layout.astro";
import {company} from "../../data/company";
const t = {"title": "Прибирання в Берліні та Бранденбурзі | KnaBa", "desc": "KnaBa: прибирання офісів, житлових будинків, скла та об’єктів після будівництва в Берліні й Бранденбурзі. Обговоріть потреби та отримайте індивідуальну пропозицію.", "eyebrow": "БЕРЛІН І БРАНДЕНБУРГ", "h1": "Чисті приміщення.", "accent": "Зрозумілі домовленості.", "intro": "KnaBa допомагає підприємствам, керуючим компаніям і власникам організувати прибирання з урахуванням об’єкта та його повсякденного використання. Розкажіть про потреби — разом узгодимо обсяг робіт, доступ і час.", "cta": "Надіслати заявку (форма німецькою)", "portal": "Відкрити Мій KnaBa", "scope": "Прибирання під потреби вашого об’єкта", "services": [["bueroreinigung", "Прибирання офісів", "Робочі місця, переговорні, приймальні, кухні та санітарні зони. Обсяг і час доступу узгоджуємо відповідно до роботи офісу."], ["unterhaltsreinigung", "Регулярне прибирання", "Узгоджений графік для приміщень і спільних зон. Частота та перелік робіт залежать від об’єкта й інтенсивності його використання."], ["treppenreinigung", "Прибирання сходових кліток", "Входи, сходи, майданчики, поручні та спільні простори житлових будинків і об’єктів керуючих компаній."], ["glasreinigung", "Миття скла та фасадів", "Вікна, скляні поверхні й рами за погодженим переліком. Фасадні роботи залежать від матеріалу та безпечного доступу."], ["baureinigung", "Прибирання після будівництва", "Прибирання під час робіт і після їх завершення з урахуванням етапу будівництва та строку передачі приміщення."], ["grundreinigung", "Генеральне й спеціальне прибирання", "Інтенсивне очищення, коли поточного догляду недостатньо. Попередньо обговорюємо стан, матеріали й відповідний спосіб робіт."]], "details": "Деталі послуги німецькою →", "prepare": "Що підготувати для звернення", "items": ["Адресу об’єкта та приблизну площу.", "Перелік приміщень і поверхонь для прибирання.", "Потребу в разовому чи регулярному обслуговуванні.", "Умови доступу та бажаний час."], "note": "Ціну й можливість виконання узгоджуємо індивідуально. Надсилання заявки ще не є замовленням або підтвердженням дати. Детальні сторінки послуг, поради та юридична інформація доступні німецькою. Кабінет також підтримує українську й англійську.", "contact": "Зв’язатися з KnaBa", "about": "KnaBa — регіональна компанія з прибирання та обслуговування нерухомості за адресою Im Achterkastell 39, 10315 Berlin. План роботи для офісу, житлового будинку чи будівельного об’єкта починається з уточнення ваших потреб."};
---
<Layout lang="uk" title={t.title} description={t.desc} alternates={[{lang:"de",url:"/"},{lang:"en",url:"/en/"},{lang:"uk",url:"/uk/"},{lang:"x-default",url:"/"}]}>
<section class="container page-intro locale-intro"><p class="eyebrow">{t.eyebrow}</p><h1>{t.h1}<br/><span>{t.accent}</span></h1><p>{t.intro}</p><div class="hero-actions"><a class="button button-dark" href="/kontakt/">{t.cta} →</a><a class="text-link" href="/konto/?lang=uk">{t.portal} →</a></div></section>
<section class="container section"><h2>{t.scope}</h2><div class="locale-grid">{t.services.map(([slug,title,text])=><article><h2>{title}</h2><p>{text}</p><a class="text-link" href={`/leistungen/${slug}/`}>{t.details}</a></article>)}</div></section>
<section class="container section seo-story"><div><h2>{t.prepare}</h2><ul>{t.items.map(item=><li>{item}</li>)}</ul><p>{t.note}</p></div><div><h2>{t.contact}</h2><p>{t.about}</p><p><a class="text-link" href={company.phoneHref}>{company.phone}</a></p><p><a class="text-link" href={`mailto:${company.email}`}>{company.email}</a></p></div></section>
</Layout>
