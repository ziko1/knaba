---
import Layout from "../../../layouts/Layout.astro";
import Icon from "../../../components/Icon.astro";
import { services } from "../../../data/ru-content";
---

<Layout lang="ru"
  title="Услуги по уборке | KnaBa"
  description="Услуги KnaBa в Берлине и Бранденбурге: регулярная уборка, уборка офисов, подъездов и после строительства, мойка стекла и генеральная уборка."
>
  <section class="container page-intro">
    <p class="eyebrow">УСЛУГИ</p><h1>
      У чистоты<br /><span>много сторон.</span>
    </h1><p>
      Вместе подберём уборку для вашего объекта — регулярную, разовую или для особого случая.
    </p>
  </section>
  <section class="container section section-tight">
    <div class="service-grid">
      {
        services.map((s, i) => (
          <a class="service-card" href={`/ru/leistungen/${s.slug}/`}>
            <>
              <div class="service-card-top">
                <>
                  <span class="service-icon">
                    <Icon name={s.icon} size={30} />
                  </span>
                  <span class="service-number">0{i + 1}</span>
                </>
              </div>
              <span class="eyebrow">{s.tag}</span>
              <h2>{s.name}</h2>
              <p>{s.description}</p>
              <span class="service-card-bottom">
                Подробнее об услуге <Icon name="diagonal" size={18} />
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="container cta-banner">
    <div>
      <p class="eyebrow">ЕЩЁ НЕ ОПРЕДЕЛИЛИСЬ?</p><h2>
        Обсудим<br />ваши потребности.
      </h2>
    </div><a class="button button-dark" href="/ru/kontakt/"
      >Запросить консультацию <Icon /></a>
  </section>
</Layout>
