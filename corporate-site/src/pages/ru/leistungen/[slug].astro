---
import Layout from "../../../layouts/Layout.astro";
import { serviceArtwork } from "../../../data/service-artwork";
import Icon from "../../../components/Icon.astro";
import { services, type RussianService as Service } from "../../../data/ru-content";
import { serviceContent, guides } from "../../../data/ru-content";
import { siteConfig } from "../../../data/site";
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
interface Props { service: Service }
const { service } = Astro.props;
const content = serviceContent[service.slug];
const guide = guides.find((item) => item.slug === content.relatedGuide)!;
const canonical = `${siteConfig.origin}/ru/leistungen/${service.slug}/`;
const schema = {
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: content.title,
  description: content.metaDescription,
  serviceType: service.name,
  provider: { '@id': `${siteConfig.officialOrigin}/#business` },
  areaServed: ['Berlin', 'Brandenburg'],
  url: canonical,
};
---

<Layout lang="ru"
  title={`${content.title} | KnaBa`}
  description={content.metaDescription}
  schema={schema}
  breadcrumbs={[{ name: 'Главная', url: '/ru/' }, { name: 'Услуги', url: '/ru/leistungen/' }, { name: service.name, url: `/ru/leistungen/${service.slug}/` }]}
>
  <section class="container page-intro">
    <a href="/ru/leistungen/" class="breadcrumb">← Все услуги</a><p
      class="eyebrow"
    >
      {service.tag}
    </p><h1>{content.title}</h1><p>{content.intro}</p><a
      class="button button-dark"
      href={`/ru/kontakt/?leistung=${service.slug}`}
      >Запросить эту уборку <Icon /></a>
  </section>
  <section class="container section section-tight detail-grid">
    <div>
      <h2>{service.short}</h2><p>
        Для {service.audience}. Обсудим ваши потребности и вместе определим задачи и объём работ.
      </p><h3>Какие работы можно согласовать</h3><ul class="check-list">
        {
          content.scopeItems.map((item) => (
            <li>
              <Icon name="check" size={20} />
              {item}
            </li>
          ))
        }
      </ul><p class="muted">
        Точный объём и возможность выполнения фиксируются в индивидуальном предложении.
      </p>
      <div class="service-editorial">
        {content.sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}
      </div>
    </div><aside class="aside-card">
      <img class="detail-service-art" src={serviceArtwork[service.slug].src} alt={serviceArtwork[service.slug].alt.ru} width="720" height="500" loading="lazy" decoding="async" /><Icon name={service.icon} size={36} /><h2>
        Чтобы хорошо подготовиться.
      </h2><p>{service.questions}</p><p>
        Площадь или дата ещё неизвестны? Всё равно свяжитесь с нами.
      </p><ul class="preparation-list">{content.preparation.map((item) => <li>{item}</li>)}</ul><a href={`/ru/kontakt/?leistung=${service.slug}`} class="text-link"
        >Подготовить заявку <Icon size={19} /></a>
      <hr /><p class="eyebrow">ПОЛЕЗНЫЙ МАТЕРИАЛ</p><a class="guide-link" href={`/ru/ratgeber/${guide.slug}/`}>{guide.title} <span aria-hidden="true">→</span></a>
    </aside>
  </section>
  <section class="container section faq-section service-faq">
    <div><p class="eyebrow">ХОРОШАЯ ПОДГОТОВКА</p><h2>Ваши вопросы.<br />Наши ответы.</h2><p>Конкретные услуги, сроки и цены согласуем в индивидуальном предложении.</p></div>
    <div class="faq-list">{content.faq.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
  </section>
  <section class="container cta-banner"><div><p class="eyebrow">ВАШ ОБЪЕКТ. ВАШ ПЛАН УБОРКИ.</p><h2>Обсудим<br />ваши потребности.</h2><p>Берлин и Бранденбург · Индивидуальное согласование</p></div><a class="button button-dark" href={`/ru/kontakt/?leistung=${service.slug}`}>Запросить предложение <Icon /></a></section>
  <section class="container section">
    <p class="eyebrow">ДРУГИЕ УСЛУГИ</p><div class="related-links">
      {
        services
          .filter((s) => s.slug !== service.slug)
          .map((s) => (
            <a href={`/ru/leistungen/${s.slug}/`}>
              {s.name}
              <Icon size={18} />
            </a>
          ))
      }
    </div>
  </section>
</Layout>

<style>
  .service-editorial { margin-top: 48px; max-width: 740px; }
  .service-editorial section + section { margin-top: 40px; }
  .service-editorial h2 { font-size: clamp(26px, 2.4vw, 34px); }
  .service-editorial p { font-size: 15px; }
  .aside-card { align-self: start; }
  .preparation-list { padding-left: 20px; line-height: 1.7; font-size: 14px; color: var(--muted); }
  .preparation-list li { margin-bottom: 10px; }
  .aside-card hr { border: 0; border-top: 1px solid #bdb5d3; margin: 28px 0; }
  .guide-link { display: inline-block; text-decoration: underline; text-underline-offset: 4px; line-height: 1.6; }
  .service-faq { border-top: 1px solid var(--line); }
  .cta-banner p:not(.eyebrow) { margin: 18px 0 0; }
</style>
