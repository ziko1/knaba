---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { guides } from '../../../data/ru-content';
import { siteConfig } from '../../../data/site';
const schema = {
  '@type': 'CollectionPage',
  name: 'Советы по уборке зданий',
  url: `${siteConfig.origin}/ru/ratgeber/`,
  inLanguage: 'ru',
  mainEntity: { '@type': 'ItemList', itemListElement: guides.map((guide, index) => ({ '@type': 'ListItem', position: index + 1, name: guide.title, url: `${siteConfig.origin}/ru/ratgeber/${guide.slug}/` })) },
};
---
<Layout lang="ru" title="Советы по уборке: планирование и списки | KnaBa" description="Практические списки для уборки офисов, подъездов и после строительства. Подготовьте заявку и сравните предложения по понятным критериям." schema={schema} breadcrumbs={[{ name: 'Главная', url: '/ru/' }, { name: 'Советы', url: '/ru/ratgeber/' }]}>
  <section class="container page-intro"><p class="eyebrow">ЗНАНИЯ ДЛЯ ПОВСЕДНЕВНЫХ ЗАДАЧ</p><h1>Хорошая подготовка.<br /><span>Ясные договорённости.</span></h1><p>Какие данные нужны клининговой компании? Что включить в перечень работ? Наши материалы помогут упорядочить требования и подготовить понятную заявку.</p></section>
  <section class="container section section-tight" aria-label="Все материалы"><div class="guide-grid">{guides.map((guide, index) => <article class="guide-card"><span class="guide-number" aria-hidden="true">0{index + 1}</span><p class="eyebrow">{guide.eyebrow}</p><h2><a href={`/ru/ratgeber/${guide.slug}/`}>{guide.title}</a></h2><p>{guide.description}</p><a class="text-link" href={`/ru/ratgeber/${guide.slug}/`}>Читать материал <Icon size={18}/></a><span class="read-time">Около {guide.readMinutes} мин. · Со списком для проверки</span></article>)}</div></section>
  <section class="container cta-banner"><div><p class="eyebrow">ОТ ЗНАНИЙ К ЗАЯВКЕ</p><h2>Следующий шаг:<br />спланировать уборку.</h2><p>Планировщик поможет выбрать подходящую услугу.</p></div><a href="/ru/planer/" class="button button-dark">Открыть планировщик <Icon /></a></section>
</Layout>
<style>
  .guide-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .guide-card { padding: clamp(24px, 4vw, 40px); border-radius: 22px; background: #e4ecf7; display: flex; flex-direction: column; align-items: flex-start; }
  .guide-card:nth-child(2) { background: #f7e4db; }
  .guide-card:nth-child(3) { background: #ebe7f6; }
  .guide-card:nth-child(4) { background: #e9f2e0; }
  .guide-number { margin-bottom: 32px; font-size: 28px; color: #53706e; }
  .guide-card .eyebrow { margin-bottom: 14px; }
  .guide-card h2 { font-size: clamp(25px, 2.8vw, 35px); }
  .guide-card h2 a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .guide-card p:not(.eyebrow) { font-size: 15px; }
  .guide-card .text-link { margin-top: auto; }
  .read-time { font-size: 12px; color: var(--muted); margin-top: 12px; }
  .cta-banner p:not(.eyebrow) { margin-top: 18px; margin-bottom: 0; }
  @media (max-width: 650px) { .guide-grid { grid-template-columns: 1fr; } }
</style>
