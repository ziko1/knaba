---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { guides } from '../../../data/ru-content';
import { seoContentUpdated, type Guide } from '../../../data/seo-content';
import { services } from '../../../data/ru-content';
import { siteConfig } from '../../../data/site';
export function getStaticPaths() { return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } })); }
interface Props { guide: Guide }
const { guide } = Astro.props;
const service = services.find((item) => item.slug === guide.serviceSlug)!;
const schema = {
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  inLanguage: 'ru',
  datePublished: seoContentUpdated,
  dateModified: seoContentUpdated,
  publisher: { '@id': `${siteConfig.officialOrigin}/#business` },
  mainEntityOfPage: `${siteConfig.origin}/ru/ratgeber/${guide.slug}/`,
};
---
<Layout lang="ru" title={`${guide.title} | KnaBa`} description={guide.description} schema={schema} breadcrumbs={[{ name: 'Главная', url: '/ru/' }, { name: 'Советы', url: '/ru/ratgeber/' }, { name: guide.title, url: `/ru/ratgeber/${guide.slug}/` }]}>
  <article>
    <header class="container page-intro guide-intro"><a class="breadcrumb" href="/ru/ratgeber/">← Все материалы</a><p class="eyebrow">{guide.eyebrow}</p><h1>{guide.title}</h1><p>{guide.intro}</p><div class="article-meta"><span>Обновлено: <time datetime={seoContentUpdated}>24 октября 2026</time></span><span>Около {guide.readMinutes} мин. чтения</span></div></header>
    <div class="container guide-layout section section-tight">
      <div class="article-body">{guide.sections.map((section) => <section id={section.id}><h2>{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}</section>)}
        <section class="article-checklist" aria-labelledby="checklist-title"><p class="eyebrow">КРАТКИЙ СПИСОК</p><h2 id="checklist-title">Что проверить перед заявкой</h2><ul class="check-list">{guide.checklist.map((item) => <li><Icon name="check" size={20}/>{item}</li>)}</ul><p>Эти рекомендации не заменяют осмотр объекта или индивидуальное соглашение. Объём, возможность и условия выполнения согласовываются лично.</p></section>
      </div>
      <aside class="guide-aside"><nav aria-label="В этом материале"><p class="eyebrow">НА ЭТОЙ СТРАНИЦЕ</p><ol>{guide.sections.map((section) => <li><a href={`#${section.id}`}>{section.title.replace(/^\d+\. /, '')}</a></li>)}</ol></nav><div class="aside-card"><Icon name={service.icon} size={32}/><h2>Подходящая услуга</h2><p>{service.name} в Берлине и Бранденбурге.</p><a class="text-link" href={`/ru/leistungen/${service.slug}/`}>Подробнее об услуге <Icon size={18}/></a><a class="button button-dark" href={`/ru/kontakt/?leistung=${service.slug}`}>Отправить заявку <Icon size={18}/></a></div></aside>
    </div>
  </article>
  <section class="container section section-tight"><p class="eyebrow">ЧИТАЙТЕ ДАЛЬШЕ</p><h2>Другие полезные материалы</h2><div class="related-links">{guides.filter((item) => item.slug !== guide.slug).map((item) => <a href={`/ru/ratgeber/${item.slug}/`}>{item.title}<Icon size={18}/></a>)}</div></section>
</Layout>
<style>
  .guide-intro h1 { max-width: 1000px; font-size: clamp(36px, 5vw, 66px); }
  .guide-intro > p:not(.eyebrow) { max-width: 820px; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 10px 24px; color: var(--muted); font-size: 12px; padding-top: 10px; }
  .guide-layout { display: grid; grid-template-columns: minmax(0, 760px) minmax(240px, 330px); gap: clamp(32px, 7vw, 100px); align-items: start; }
  .article-body > section { scroll-margin-top: 32px; }
  .article-body > section + section { margin-top: 44px; }
  .article-body h2 { font-size: clamp(27px, 2.8vw, 36px); line-height: 1.25; }
  .article-body p, .article-body li { font-size: 16px; line-height: 1.85; }
  .article-body ul:not(.check-list) { padding-left: 23px; color: var(--muted); }
  .article-body li { margin-bottom: 9px; }
  .article-checklist { background: #e9f2e0; padding: clamp(22px, 4vw, 35px); border-radius: 20px; }
  .article-checklist p:last-child { font-size: 13px; margin: 24px 0 0; }
  .guide-aside nav { border: 1px solid var(--line); border-radius: 18px; padding: 26px; margin-bottom: 24px; }
  .guide-aside ol { margin: 0; padding-left: 20px; }
  .guide-aside li { font-size: 14px; line-height: 1.7; padding-left: 4px; margin-bottom: 12px; }
  .guide-aside li:last-child { margin-bottom: 0; }
  .guide-aside li a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .guide-aside .aside-card { padding: 26px; }
  .guide-aside h2 { margin-top: 22px; }
  .guide-aside .button { margin-top: 20px; width: 100%; gap: 10px; }
  @media (max-width: 850px) { .guide-layout { grid-template-columns: 1fr; } .guide-aside { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } .guide-aside nav { margin: 0; } }
  @media (max-width: 560px) { .guide-aside { grid-template-columns: 1fr; } }
</style>
