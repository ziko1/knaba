---
import Layout from "../../layouts/Layout.astro";
import { serviceArtwork } from "../../data/service-artwork";
import Icon from "../../components/Icon.astro";
import { company } from "../../data/company";
import { services } from "../../data/ru-content";
const faqs = [
  ["Какая уборка подойдёт моему объекту?", "Для офиса, подъезда или стройки планировщик поможет выбрать нужные услуги. Точный объём мы затем согласуем вместе."],
  ["Сколько стоит уборка?", "Затраты зависят от площади, состояния, доступа и частоты. Вы получите индивидуальное предложение для своего объекта."],
  ["Возможна ли регулярная уборка?", "Да. Для регулярной уборки согласуем нужные работы и подходящий график. Часы работы и доступ обсудим с вами."],
  ["В каком регионе работает KnaBa?", "Мы предлагаем уборку зданий в Берлине и Бранденбурге. Возможность и условия обслуживания конкретного объекта уточняем лично."],
];
---
<Layout lang="ru" alternates={[{lang:"de",url:"/"},{lang:"en",url:"/en/"},{lang:"uk",url:"/uk/"},{lang:"ru",url:"/ru/"},{lang:"x-default",url:"/"}]} schema={{"@type":"FAQPage",mainEntity:faqs.map(([question,answer])=>({"@type":"Question",name:question,acceptedAnswer:{"@type":"Answer",text:answer}}))}} title="Уборка в Берлине | KnaBa для офисов и недвижимости" description="Чистые помещения. Понятные договорённости. KnaBa — уборка офисов, недвижимости и строительных объектов в Берлине и Бранденбурге. Спланируйте уборку.">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="hero-pill"><span class="dot"></span> УБОРКА ЗДАНИЙ · БЕРЛИН И БРАНДЕНБУРГ</span></p>
      <h1>Чистые помещения.<br /><span class="hero-highlight">Ясные договорённости.</span><span class="hero-spark" aria-hidden="true">✳</span></h1>
      <p class="hero-description">Больше пространства для важного.<br />Уборка для компаний, недвижимости и стройплощадок. Индивидуально согласована. До мелочей.</p>
      <div class="hero-actions"><a class="button button-dark" href="/ru/planer/">Составить план уборки <Icon size={20} /></a><a class="text-link" href="/ru/leistungen/">Посмотреть услуги <Icon name="diagonal" size={18} /></a></div>
      <div class="hero-notes"><span><Icon name="check" size={17} /> С учётом вашего объекта</span><span><Icon name="check" size={17} /> Прямая связь</span></div>
    </div>
    <div class="hero-art">
      <div class="art-caption"><span class="tiny-cross" aria-hidden="true">✳</span> ПРОСТРАНСТВО ДЛЯ КОМФОРТА.</div>
      <img class="office-art" src="/illustrations/hero-cleaning.svg" width="720" height="500" alt="Яркая 2D-иллюстрация команды KnaBa за уборкой офиса" decoding="async" fetchpriority="high" />
      <div class="art-tag"><span class="label-icon"><Icon name="sparkle" size={25}/></span><span><strong>Ваш объект. Наше внимание.</strong><small>Начинаем с подходящего плана.</small></span></div>
      <a class="art-round-link" href="/ru/planer/" aria-label="Открыть планировщик уборки"><Icon name="diagonal" size={29}/></a>
      <span class="art-credit">ИЛЛЮСТРАЦИЯ · НЕ ОБЪЕКТ КЛИЕНТА</span>
    </div>
  </section>
  <div class="trust-band"><div class="container"><span>ЧИСТОТА КАЖДЫЙ ДЕНЬ</span><a href="/ru/branchen/">Офисы и бизнес <span aria-hidden="true">↗</span></a><a href="/ru/branchen/">Управляющие компании <span aria-hidden="true">↗</span></a><a href="/ru/leistungen/baureinigung/">Строительство и недвижимость <span aria-hidden="true">↗</span></a></div></div>

  <section class="section container section-tight" aria-labelledby="bauhilfe-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">ТАКЖЕ НА СТРОЙПЛОЩАДКЕ</p>
        <h2 id="bauhilfe-heading">Не только уборка.<br />Помощь на стройплощадке.</h2>
      </div>
      <div>
        <p>Помимо уборки после строительства, KnaBa указывает на официальном сайте подсобные строительные работы и подготовку стройплощадки. Возможные задачи, объём и стоимость согласуются лично.</p>
        <a class="text-link" href="/ru/kontakt/">Уточнить строительные работы <Icon name="diagonal" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section container" id="leistungen">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-dot"></span> ЧЕМ МЫ МОЖЕМ ПОМОЧЬ</p><h2>Для каждого помещения<br />подходящее решение.</h2></div><div><p>От повседневного ухода до окончательной уборки.<br />Выберите то, что подходит вашему объекту.</p><a class="text-link" href="/ru/leistungen/">Все услуги <Icon size={18}/></a></div></div>
    <div class="service-grid">{services.map((s,i)=><a class="service-card" href={`/ru/leistungen/${s.slug}/`}><div class="service-card-top"><span class="service-icon"><Icon name={s.icon} size={28}/></span><span class="service-number">0{i+1}</span></div><img class="service-card-art" src={serviceArtwork[s.slug].src} alt={serviceArtwork[s.slug].alt.ru} width="720" height="500" loading="lazy" decoding="async" /><span class="eyebrow">{s.tag}</span><h3>{s.name}</h3><p>{s.description}</p><span class="service-card-bottom">Подробнее <span class="card-arrow"><Icon name="diagonal" size={18}/></span></span></a>)}</div>
  </section>

  <section class="container planner-banner" aria-labelledby="plan-title"><div class="planner-copy"><p class="eyebrow">НЕСКОЛЬКО КЛИКОВ. БОЛЬШЕ ЯСНОСТИ.</p><h2 id="plan-title">Ваш объект уникален.<br /><span>План уборки — тоже.</span></h2><p>Выберите подходящую услугу, подготовьтесь к разговору и перенесите свой выбор прямо в заявку.</p><a href="/ru/planer/" class="button button-dark">Составить план уборки <Icon size={20}/></a><span class="planner-footnote">Без регистрации. Без обещаний фиксированной цены.</span></div><div class="plan-preview" aria-hidden="true"><div class="plan-preview-top"><span class="plan-mini-logo">K.</span><span>МОЙ ПЛАН УБОРКИ</span><span class="plan-preview-dot"></span></div><div class="plan-preview-title">Внимание к вашим потребностям.</div><div class="plan-preview-row"><span class="plan-check">✓</span><div><strong>Ваш тип объекта</strong><small>Офис, недвижимость или стройка</small></div><span class="plan-step">01</span></div><div class="plan-preview-row"><span class="plan-check lilac">✓</span><div><strong>Ваша услуга</strong><small>Выбрать и согласовать</small></div><span class="plan-step">02</span></div><div class="plan-preview-row"><span class="plan-check coral">↗</span><div><strong>Готовы к разговору</strong><small>Краткое описание для заявки</small></div><span class="plan-step">03</span></div></div></section>

  <section class="approach"><div class="container approach-grid"><div><p class="eyebrow">ЧИСТОТА И ПОРЯДОК В РАБОТЕ.</p><h2>Вы занимаетесь<br />своим делом.<br /><span>Мы — чистотой.</span></h2><p>Хорошая уборка начинается с понимания. Обсудим ваши помещения, рабочие процессы и ожидаемый результат.</p><a href="/ru/unternehmen/" class="text-link light">Познакомиться с KnaBa <Icon size={19}/></a></div><div class="principles">{[["01","План, который подходит вам","Подбираем объём работ, материалы и интервалы с учётом вашего объекта."],["02","Простой и прямой разговор","Прямая связь и ясные договорённости — от первого разговора до текущего взаимодействия."],["03","Работаем в вашем регионе","Уборка зданий в Берлине и Бранденбурге. С личным контактом в Берлине."]].map(([n,t,d])=><div><span>{n}</span><div><h3>{t}</h3><p>{d}</p></div></div>)}</div></div></section>

  <section class="section container"><div class="section-heading"><div><p class="eyebrow"><span class="section-dot coral"></span> ПУТЬ К СОТРУДНИЧЕСТВУ</p><h2>Всё понятно.<br />С первого обращения.</h2></div><p>Чёткий порядок. Общее понимание.<br />И предложение под ваши реальные потребности.</p></div><div class="steps">{[["01","Опишите потребности","Выберите услугу в планировщике или свяжитесь с нами напрямую."],["02","Согласуйте детали","Уточним объём, доступ и сроки. При необходимости — на месте."],["03","Согласуйте предложение","Вы получите индивидуальное предложение. Начало работ согласовываем вместе."]].map(([n,t,d])=><div><span>{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></section>

  <section class="container region-section"><div class="region-graphic" aria-hidden="true"><div class="map-grid"></div><div class="map-orbit orbit-one"></div><div class="map-orbit orbit-two"></div><div class="map-center"><span><Icon name="pin" size={25}/></span><strong>Берлин</strong><small>+ Бранденбург</small></div><span class="map-caption">РЯДОМ. НА ПРЯМОЙ СВЯЗИ.</span></div><div class="region-copy"><p class="eyebrow">БЕРЛИН И БРАНДЕНБУРГ</p><h2>Для ваших помещений.<br />В вашем регионе.</h2><p>Офис в городе или недвижимость за его пределами: обсудите с нами расположение и нужный объём работ.</p><a href={company.phoneHref} class="text-link"><Icon name="phone" size={18}/>{company.phone}</a></div></section>

  <section class="section container seo-story" aria-labelledby="berlin-cleaning"><div><p class="eyebrow">КЛИНИНГОВАЯ КОМПАНИЯ В БЕРЛИНЕ</p><h2 id="berlin-cleaning">Чтобы ваш объект<br />создавал хорошее впечатление.</h2><p>Ухоженный офис делает рабочий день приятнее. Чистый подъезд встречает жильцов и гостей. После строительства или ремонта согласованная окончательная уборка готовит объект к передаче. KnaBa объединяет эти задачи с индивидуальным вниманием к вашему объекту.</p><p>Из Берлина мы организуем обсуждение уборки в городе и окрестностях Бранденбурга. Сообщите расположение, площадь и потребности. Вместе уточним услуги и время, подходящие вашей недвижимости.</p><a href="/ru/berlin/" class="text-link">Подробнее об уборке в Берлине →</a></div><div><h3>Что входит в хороший план уборки?</h3><ul><li>Чёткий перечень помещений, поверхностей и задач.</li><li>Подходящая частота для более и менее загруженных зон.</li><li>Согласованное время доступа и ответственное обращение с ключами.</li><li>Согласование материалов, рекомендаций по уходу и особых требований.</li><li>Доступное контактное лицо для вопросов и изменений.</li></ul><p>Именно эти пункты можно подготовить через наш <a href="/ru/planer/">планировщик уборки</a>. Без аккаунта можно отправить заявку. А после одобрения доступа в клиентском кабинете вы сможете видеть свои обращения и их статус.</p><a href="/ru/konto/" class="text-link">Открыть Мой KnaBa →</a></div></section>
  <section class="container section" aria-labelledby="guide-home"><p class="eyebrow">ПОЛЕЗНОЕ ДЛЯ ВАШЕГО ОБЪЕКТА</p><h2 id="guide-home">Лучше подготовка.<br />Проще решение.</h2><div class="guide-teasers"><article class="guide-teaser"><span class="eyebrow">ПЛАНИРОВАНИЕ</span><h3>Правильно согласовать услуги</h3><p>Какие сведения нужны для обоснованного предложения? В наших материалах объясняем главное.</p><a href="/ru/ratgeber/">Перейти к советам →</a></article><article class="guide-teaser"><span class="eyebrow">РЕГУЛЯРНЫЙ УХОД</span><h3>График под ваш ритм</h3><p>Использование, поток посетителей и особенности зон определяют потребности. Так отдельные задачи складываются в понятный план.</p><a href="/ru/leistungen/unterhaltsreinigung/">О регулярной уборке →</a></article><article class="guide-teaser"><span class="eyebrow">СТРОИТЕЛЬНЫЕ ОБЪЕКТЫ</span><h3>Подготовиться к передаче</h3><p>Промежуточная, тщательная и окончательная уборка решают разные задачи. Уточните этап строительства и ожидаемое состояние к передаче.</p><a href="/ru/leistungen/baureinigung/">Подробнее о строительной уборке →</a></article></div></section>
  <section class="section container faq-section"><div><p class="eyebrow">ПОЛЕЗНО ЗНАТЬ</p><h2>Несколько вопросов.<br />Понятные ответы.</h2><p>Не нашли свой вопрос?</p><a href="/ru/kontakt/" class="text-link">Давайте обсудим <Icon size={18}/></a></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
  <section class="container cta-banner"><div><p class="eyebrow">ПЕРВЫЙ ШАГ — ПРОСТОЙ.</p><h2>Чистые помещения.<br />Начинаются с разговора.</h2></div><a class="button button-dark" href="/ru/kontakt/">Оставить заявку на уборку <Icon size={20}/></a></section>
</Layout>
