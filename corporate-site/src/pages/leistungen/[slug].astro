---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { services } from "../../data/company";
export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
---

<Layout
  title={`${service.name} in Berlin & Brandenburg | KnaBa`}
  description={service.description}
>
  <section class="container page-intro">
    <a href="/leistungen/" class="breadcrumb">← Alle Leistungen</a><p
      class="eyebrow"
    >
      {service.tag}
    </p><h1>{service.name}</h1><p>{service.description}</p><a
      class="button button-dark"
      href={`/kontakt/?leistung=${service.slug}`}
      >Diese Reinigung anfragen <Icon /></a>
  </section>
  <section class="container section section-tight detail-grid">
    <div>
      <h2>{service.short}</h2><p>
        Für {service.audience.toLowerCase()}. Wir besprechen Ihren Bedarf und
        legen gemeinsam fest, welche Arbeiten in welchem Umfang ausgeführt
        werden.
      </p><h3>Das können wir für Sie übernehmen</h3><ul class="check-list">
        {
          service.details.map((item) => (
            <li>
              <Icon name="check" size={20} />
              {item}
            </li>
          ))
        }
      </ul><p class="muted">
        Der genaue Leistungsumfang und die Verfügbarkeit werden im individuellen
        Angebot vereinbart.
      </p>
    </div><aside class="aside-card">
      <Icon name={service.icon} size={36} /><h2>
        Damit wir gut planen können.
      </h2><p>{service.questions}</p><p>
        Die Fläche oder der Termin steht noch nicht fest? Sprechen Sie uns
        trotzdem an.
      </p><a href={`/kontakt/?leistung=${service.slug}`} class="text-link"
        >Anfrage vorbereiten <Icon size={19} /></a>
    </aside>
  </section>
  <section class="container section">
    <p class="eyebrow">WEITERE LEISTUNGEN</p><div class="related-links">
      {
        services
          .filter((s) => s.slug !== service.slug)
          .map((s) => (
            <a href={`/leistungen/${s.slug}/`}>
              {s.name}
              <Icon size={18} />
            </a>
          ))
      }
    </div>
  </section>
</Layout>
