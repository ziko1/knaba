---
import Layout from "../../layouts/Layout.astro";
import {serviceArtwork} from "../../data/service-artwork";
import {company} from "../../data/company";
const t = {"title": "Cleaning services in Berlin | KnaBa", "desc": "KnaBa provides cleaning for offices, residential properties and construction projects in Berlin and Brandenburg. Discuss your property and request an individual offer.", "eyebrow": "BERLIN & BRANDENBURG", "h1": "Clean spaces.", "accent": "Clear arrangements.", "intro": "KnaBa helps businesses, property managers and owners plan cleaning around their buildings and daily routines. Tell us what you need, and we will discuss the scope, access and timing together.", "cta": "Request cleaning (German form)", "portal": "Open My KnaBa", "scope": "Cleaning that fits your property", "services": [["bueroreinigung", "Office cleaning", "Workspaces, meeting rooms, reception areas, kitchenettes and sanitary facilities. Agree on the areas and access times that suit your office."], ["unterhaltsreinigung", "Regular cleaning", "An agreed cleaning routine for frequently used rooms and communal areas. Frequency and scope depend on the building and its use."], ["treppenreinigung", "Stairwell cleaning", "Entrances, stairs, landings, handrails and shared spaces for residential buildings and property management."], ["glasreinigung", "Window and facade cleaning", "Glass surfaces, windows and frames according to the agreed scope. Facade work depends on materials and safe access."], ["baureinigung", "Construction cleaning", "Cleaning during building work and after completion, with the construction stage and handover date taken into account."], ["grundreinigung", "Deep and special cleaning", "Intensive cleaning when routine maintenance is not enough. We discuss the condition, material and suitable approach."]], "details": "Service details (German) →", "prepare": "A good enquiry starts with the essentials", "items": ["Your property location and approximate floor area.", "The spaces and surfaces that need cleaning.", "Whether you need a one-off visit or recurring service.", "Access arrangements and preferred times."], "note": "Prices and availability are agreed individually. Sending an enquiry does not place an order or confirm a date. The detailed service pages, guides and legal notices are in German. The customer portal also supports English and Ukrainian.", "contact": "Speak to KnaBa", "about": "KnaBa is a regional cleaning and property service business based at Im Achterkastell 39, 10315 Berlin. For offices, residential properties and construction projects, we begin with the details of your actual requirements."};
---
<Layout lang="en" title={t.title} description={t.desc} alternates={[{lang:"de",url:"/"},{lang:"en",url:"/en/"},{lang:"uk",url:"/uk/"},{lang:"x-default",url:"/"}]}>
<section class="container page-intro locale-intro"><p class="eyebrow">{t.eyebrow}</p><h1>{t.h1}<br/><span>{t.accent}</span></h1><p>{t.intro}</p><div class="hero-actions"><a class="button button-dark" href="/kontakt/">{t.cta} →</a><a class="text-link" href="/konto/?lang=en">{t.portal} →</a></div></section>
<section class="container section"><h2>{t.scope}</h2><div class="locale-grid">{t.services.map(([slug,title,text])=><article><img class="locale-service-art" src={serviceArtwork[slug].src} alt={serviceArtwork[slug].alt.en} width="720" height="500" loading="lazy" decoding="async" /><h2>{title}</h2><p>{text}</p><a class="text-link" href={`/leistungen/${slug}/`}>{t.details}</a></article>)}</div></section>
<section class="container section section-tight" aria-labelledby="construction-help"><h2 id="construction-help">Construction support and site preparation</h2><p>Alongside construction cleaning, the official KnaBa website also describes construction support (Bauhilfsarbeiten) and site preparation (Baustellenvorbereitung). The team confirms the tasks, scope and price individually.</p><a class="text-link" href="/kontakt/">Ask about construction support (German form) →</a></section>
<section class="container section seo-story"><div><h2>{t.prepare}</h2><ul>{t.items.map(item=><li>{item}</li>)}</ul><p>{t.note}</p></div><div><h2>{t.contact}</h2><p>{t.about}</p><p><a class="text-link" href={company.phoneHref}>{company.phone}</a></p><p><a class="text-link" href={`mailto:${company.email}`}>{company.email}</a></p></div></section>
</Layout>
