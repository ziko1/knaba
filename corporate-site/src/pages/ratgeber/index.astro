---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../data/seo-content';
import { siteConfig } from '../../data/site';
const schema = {
  '@type': 'CollectionPage',
  name: 'Ratgeber Gebäudereinigung',
  url: `${siteConfig.origin}/ratgeber/`,
  inLanguage: 'de-DE',
  mainEntity: { '@type': 'ItemList', itemListElement: guides.map((guide, index) => ({ '@type': 'ListItem', position: index + 1, name: guide.title, url: `${siteConfig.origin}/ratgeber/${guide.slug}/` })) },
};
---
<Layout title="Ratgeber Gebäudereinigung: Planung & Checklisten | KnaBa" description="Praktische Checklisten für Büro-, Bau- und Treppenhausreinigung. Bereiten Sie Ihren Reinigungsbedarf vor und vergleichen Sie Angebote nachvollziehbar." schema={schema} breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Ratgeber', url: '/ratgeber/' }]}>
  <section class="container page-intro"><p class="eyebrow">WISSEN, DAS IM ALLTAG HILFT</p><h1>Gut vorbereitet.<br /><span>Besser abgestimmt.</span></h1><p>Welche Angaben braucht eine Reinigungsfirma? Was gehört ins Leistungsverzeichnis? Unsere Ratgeber helfen Ihnen, Anforderungen zu ordnen und mit einer klaren Anfrage zu starten.</p></section>
  <section class="container section section-tight" aria-label="Alle Ratgeber"><div class="guide-grid">{guides.map((guide, index) => <article class="guide-card"><span class="guide-number" aria-hidden="true">0{index + 1}</span><p class="eyebrow">{guide.eyebrow}</p><h2><a href={`/ratgeber/${guide.slug}/`}>{guide.title}</a></h2><p>{guide.description}</p><a class="text-link" href={`/ratgeber/${guide.slug}/`}>Ratgeber lesen <Icon size={18}/></a><span class="read-time">Ca. {guide.readMinutes} Minuten · Mit Checkliste</span></article>)}</div></section>
  <section class="container cta-banner"><div><p class="eyebrow">VOM WISSEN ZUR ANFRAGE</p><h2>Ihr nächster Schritt:<br />den Bedarf planen.</h2><p>Der Reinigungsplaner hilft Ihnen bei der Auswahl.</p></div><a href="/planer/" class="button button-dark">Reinigungsplaner öffnen <Icon /></a></section>
</Layout>
<style>
  .guide-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .guide-card { padding: clamp(24px, 4vw, 40px); border-radius: 22px; background: #e4ecf7; display: flex; flex-direction: column; align-items: flex-start; }
  .guide-card:nth-child(2) { background: #f7e4db; }
  .guide-card:nth-child(3) { background: #ebe7f6; }
  .guide-card:nth-child(4) { background: #e9f2e0; }
  .guide-number { margin-bottom: 32px; font-size: 28px; color: #53706e; }
  .guide-card .eyebrow { margin-bottom: 14px; }
  .guide-card h2 { font-size: clamp(25px, 2.8vw, 35px); }
  .guide-card h2 a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .guide-card p:not(.eyebrow) { font-size: 15px; }
  .guide-card .text-link { margin-top: auto; }
  .read-time { font-size: 12px; color: var(--muted); margin-top: 12px; }
  .cta-banner p:not(.eyebrow) { margin-top: 18px; margin-bottom: 0; }
  @media (max-width: 650px) { .guide-grid { grid-template-columns: 1fr; } }
</style>
