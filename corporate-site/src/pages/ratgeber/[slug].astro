---
import Legacy from '../../components/ConstructionLegacy.astro';
import ConstructionGuide from '../../components/ConstructionGuide.astro';
import {constructionGuides, constructionGuideBySlug} from '../../data/construction-guides';
import {guides} from '../../data/seo-content.ts';
export function getStaticPaths(){
  return [...new Set([...guides.map(item=>item.slug),...constructionGuides.map(item=>item.slug)])].map(slug=>({params:{slug}}));
}
const {slug}=Astro.params;
const guide=constructionGuideBySlug(slug!);
---
{guide ? <ConstructionGuide locale="de" guide={guide}/> : <Legacy locale="de" slug={slug!} kind="guide"/>}
