---
import Layout from '../layouts/Layout.astro';
import Portal from '../components/Portal.tsx';
---
<Layout title="Mein KnaBa | Kunden- und Mitarbeiterportal" description="Ihr KnaBa Portal für Reinigungsanfragen, geplante Einsätze und die Zusammenarbeit mit unserem Team. Persönlicher Zugang mit Freigabe durch den Inhaber." noindex={true}>
  <section class="container portal-page">
    <div class="portal-page-intro"><p class="eyebrow">KnaBa. Persönlich verbunden.</p><h1>Ein guter Plan.<br/><span>Ein sauberer Ablauf.</span></h1><p>Ihr direkter Weg zu Anfragen, Einsätzen und einer gut organisierten Zusammenarbeit.</p></div>
    <Portal client:load />
    <noscript><p class="notice">Das Kundenportal benötigt JavaScript. Für eine Anfrage erreichen Sie uns unter <a href="mailto:kontakt@knaba.de">kontakt@knaba.de</a>.</p></noscript>
  </section>
</Layout>
<style>
  .portal-page{padding-top:clamp(2.5rem,5vw,5rem)}.portal-page-intro{max-width:50rem}.portal-page-intro h1{font-size:clamp(2.6rem,5vw,4.5rem);margin-bottom:1.2rem}.portal-page-intro h1 span{color:#3d7561}.portal-page-intro>p:last-child{max-width:38rem;font-size:1.05rem;margin-bottom:2rem}
</style>
