---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { company, services } from '../data/company';
import { siteConfig } from '../data/site';
const schema = { '@type': 'WebPage', name: 'Gebäudereinigung in Berlin und Brandenburg', url: `${siteConfig.origin}/berlin/`, about: { '@id': `${siteConfig.officialOrigin}/#business` }, inLanguage: 'de-DE' };
---
<Layout title="Gebäudereinigung Berlin & Brandenburg: Einsatzgebiet | KnaBa" description="KnaBa: Ihr Kontakt für Gebäude-, Büro-, Bau- und Treppenhausreinigung in Berlin und Brandenburg. Besprechen Sie Standort, Umfang und Termine Ihres Objekts." schema={schema} breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Berlin & Brandenburg', url: '/berlin/' }]}>
  <section class="container page-intro"><p class="eyebrow">IN BERLIN ZU HAUSE</p><h1>Saubere Räume.<br /><span>In Ihrer Region.</span></h1><p>KnaBa bietet Gebäudereinigung in Berlin und Brandenburg. Wir sind Ihr Ansprechpartner für die regelmäßige Pflege von Büro- und Gewerbeflächen, für Treppenhäuser, Glasflächen und die Reinigung von Bauprojekten.</p><a href="/kontakt/" class="button button-dark">Ihr Objekt anfragen <Icon /></a></section>
  <section class="container section section-tight detail-grid"><div><h2>Ihr Standort ist der Anfang.<br />Ihr Bedarf bestimmt den Plan.</h2><p>Ob Büro, Wohnimmobilie oder Bauvorhaben: Für die Planung zählen Adresse, Nutzung, Fläche und die gewünschten Arbeiten. Teilen Sie uns auch Zugangszeiten und besondere Bedingungen vor Ort mit. Die Betreuung Ihres konkreten Objekts und mögliche Termine stimmen wir im persönlichen Gespräch ab.</p><p>Unser veröffentlichter Kontakt befindet sich in Berlin. Für Projekte in Brandenburg besprechen wir den Standort und den Umfang ebenso individuell. Eine pauschale Anfahrts- oder Sofortzusage wäre ohne diese Angaben nicht verlässlich.</p><h3>Für diese Aufgaben können Sie uns ansprechen</h3><ul class="check-list"><li><Icon name="check" size={20}/>Regelmäßige Reinigung von Büro- und Gewerbeflächen</li><li><Icon name="check" size={20}/>Treppenhäuser und Gemeinschaftsbereiche von Immobilien</li><li><Icon name="check" size={20}/>Baugrob-, Baufein- und Bauendreinigung</li><li><Icon name="check" size={20}/>Glas-, Grund- und Sonderreinigung nach Abstimmung</li></ul></div><aside class="aside-card"><p class="eyebrow">IHR DIREKTER KONTAKT</p><h2>KnaBa in Berlin</h2><address>{company.street}<br />{company.city}</address><a class="text-link" href={company.phoneHref}><Icon name="phone" size={18}/>{company.phone}</a><a class="text-link" href={`mailto:${company.email}`}>{company.email} <Icon size={18}/></a><p class="visit-note">Bitte vereinbaren Sie persönliche Termine vorab.</p></aside></section>
  <section class="container section section-tight"><div class="section-heading"><div><p class="eyebrow">PASSEND ZU IHREM OBJEKT</p><h2>Unsere Reinigungsleistungen</h2></div><p>Die genaue Ausführung und Verfügbarkeit werden individuell vereinbart.</p></div><div class="related-links">{services.map((service) => <a href={`/leistungen/${service.slug}/`}>{service.name}<Icon size={18}/></a>)}</div></section>
  <section class="container region-planning"><div><p class="eyebrow">SO WIRD DIE ANFRAGE KONKRET</p><h2>Vier Angaben.<br />Ein guter Start.</h2></div><ol><li><strong>Wo?</strong><span>Adresse oder Postleitzahl des Reinigungsobjekts.</span></li><li><strong>Was?</strong><span>Objektart, ungefähre Fläche und gewünschte Leistung.</span></li><li><strong>Wann?</strong><span>Gewünschter Beginn, Turnus und mögliche Zeitfenster.</span></li><li><strong>Was ist besonders?</strong><span>Zugang, Material, Bauphase oder weitere Anforderungen.</span></li></ol></section>
  <section class="container cta-banner"><div><p class="eyebrow">GEMEINSAM GUT VORBEREITET</p><h2>Ihre Reinigung<br />beginnt mit einem Plan.</h2></div><a class="button button-dark" href="/planer/">Bedarf im Planer auswählen <Icon /></a></section>
</Layout>
<style>
  address { font-style: normal; line-height: 1.8; margin: 24px 0; }
  .aside-card { align-self: start; }
  .aside-card .text-link { display: flex; overflow-wrap: anywhere; }
  .visit-note { margin: 20px 0 0; }
  .region-planning { margin-block: 28px 80px; background: #e5edf7; padding: clamp(26px, 5vw, 58px); border-radius: 22px; display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; }
  .region-planning ol { margin: 0; padding-left: 24px; }
  .region-planning li { padding: 12px 0 16px 8px; border-bottom: 1px solid #c6d5de; }
  .region-planning li:first-child { padding-top: 0; }
  .region-planning li:last-child { border-bottom: 0; }
  .region-planning strong { display: block; font-size: 18px; margin-bottom: 6px; }
  .region-planning span { display: block; font-size: 14px; color: var(--muted); line-height: 1.7; }
  @media (max-width: 700px) { .region-planning { grid-template-columns: 1fr; gap: 20px; } }
</style>
