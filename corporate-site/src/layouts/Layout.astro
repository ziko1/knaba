---
import "../styles/global.css";
import { company } from "../data/company";
import { siteConfig } from "../data/site";
import Icon from "../components/Icon.astro";

import { languageLinks, localeAlternates } from "../lib/site-i18n";
import { ClientRouter } from "astro:transitions";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lang?: 'de' | 'en' | 'uk' | 'ru';
  schema?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: {name:string;url:string}[];
  alternates?: {lang:string;url:string}[];
}
const { title, description, noindex = false, lang = 'de', schema = [], breadcrumbs = [], alternates = [] } = Astro.props;
const isNoindex = !siteConfig.indexable || noindex;
const translated = {
  de: {skip:'Zum Inhalt springen', preview:'Temporäre Vorschau', official:'Zur offiziellen Website', region:'Ihr Reinigungspartner in Berlin & Brandenburg', quote:'Angebot anfragen', account:'Mein KnaBa',menu:'Menü', discover:'Entdecken', contact:'Kontakt', next:'Ihr nächster Schritt', nextText:'Erzählen Sie uns von Ihrem Objekt. Wir besprechen Ihren Bedarf.', tagline:'Gepflegte Räume. Ein gutes Gefühl.', privacy:'Datenschutz', imprint:'Impressum', retire:'Temporäre Vorschau auf kneba.vsp.rest. Diese Adresse kann nach dem Umzug zur offiziellen Website wieder entfernt werden.'},
  en: {skip:'Skip to content',preview:'Temporary preview',official:'Official website',region:'Your cleaning partner in Berlin & Brandenburg',quote:'Request cleaning (DE)',account:'My KnaBa',menu:'Menu',discover:'Explore',contact:'Contact',next:'Your next step',nextText:'Tell us about your property. We will discuss your requirements.',tagline:'Clean spaces. A better feeling.',privacy:'Privacy (DE)',imprint:'Legal notice (DE)',retire:'Temporary preview at kneba.vsp.rest. This address can be removed after the move to the official website.'},
  uk: {skip:'Перейти до вмісту',preview:'Тимчасовий сайт',official:'Офіційний сайт',region:'Ваш партнер із прибирання у Берліні та Бранденбурзі',quote:'Замовити прибирання (DE)',account:'Мій KnaBa',menu:'Меню',discover:'Дізнатися більше',contact:'Контакти',next:'Ваш наступний крок',nextText:'Розкажіть про свій об’єкт. Ми обговоримо ваші потреби.',tagline:'Чисті приміщення. Приємні відчуття.',privacy:'Конфіденційність (DE)',imprint:'Юридична інформація (DE)',retire:'Тимчасовий сайт kneba.vsp.rest. Цю адресу можна видалити після перенесення на офіційний сайт.'},
  ru: {skip:'Перейти к содержимому',preview:'Временный сайт',official:'Официальный сайт',region:'Ваш партнёр по уборке в Берлине и Бранденбурге',quote:'Запросить предложение',account:'Мой KnaBa',menu:'Меню',discover:'Узнать больше',contact:'Контакты',next:'Ваш следующий шаг',nextText:'Расскажите о своём объекте. Мы обсудим ваши пожелания.',tagline:'Чистые помещения. Приятные ощущения.',privacy:'Конфиденциальность',imprint:'Юридическая информация',retire:'Временный сайт kneba.vsp.rest. Этот адрес может быть удалён после переноса на официальный сайт.'},
}[lang];
const footerLabels = {de:['Reinigungsplan erstellen','Unsere Leistungen','Ihre Branche','Ratgeber','Berlin & Umgebung','Über KnaBa','Karriere'],en:['Cleaning planner (DE)','Our services (DE)','Your sector (DE)','Guides (DE)','Berlin & surroundings (DE)','About KnaBa (DE)','Careers (DE)'],uk:['Планер прибирання (DE)','Наші послуги (DE)','Ваша галузь (DE)','Поради (DE)','Берлін та околиці (DE)','Про KnaBa (DE)','Робота (DE)'],ru:['Составить план уборки','Наши услуги','Ваша отрасль','Советы','Берлин и окрестности','О KnaBa','Вакансии']}[lang];
const path = Astro.url.pathname;
const localPath = (url: string) => lang === 'ru' ? `/ru${url}` : url;
const homePath = lang === 'de' ? '/' : `/${lang}/`;
const languages = languageLinks(path);
const pageAlternates = localeAlternates(path, alternates);
const languageLabel = {de:'Sprache',en:'Language',uk:'Мова',ru:'Язык'}[lang];
const languageNames: Record<string,string> = {de:'Deutsch',en:'English',uk:'Українська',ru:'Русский'};
const translatedNav = {en:['Services (DE)','Planner (DE)','Sectors (DE)','About (DE)','Guides (DE)'],uk:['Послуги (DE)','Планер (DE)','Галузі (DE)','Про нас (DE)','Поради (DE)'],ru:['Услуги','Планер уборки','Отрасли','О нас','Советы']};
const nav = [
  ["/leistungen/", "Leistungen"],
  ["/planer/", "Reinigungsplaner"],
  ["/branchen/", "Branchen"],
  ["/unternehmen/", "Über KnaBa"],
  ["/ratgeber/", "Ratgeber"],
].map(([url,label],index)=>[localPath(url),lang==='de'?label:translatedNav[lang][index]]);
const canonical = new URL(path, siteConfig.origin);
const breadcrumbSchema = breadcrumbs.length ? { '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({'@type':'ListItem',position:index+1,name:item.name,item:new URL(item.url,siteConfig.origin).href})) } : null;
const pageSchemas = Array.isArray(schema) ? schema : [schema];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://knaba.de/#business",
  name: "KnaBa Gebäudereinigung",
  url: siteConfig.officialOrigin,
  telephone: "+493067933054",
  email: company.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: company.street,
    postalCode: "10315",
    addressLocality: "Berlin",
    addressCountry: "DE",
  },
  areaServed: ["Berlin", "Brandenburg"],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102d34" />
    <meta name="description" content={description} />
    <meta name="robots" content={isNoindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={{de:"de_DE",en:"en_GB",uk:"uk_UA",ru:"ru_RU"}[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/knaba-social.png',siteConfig.origin)} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'ru' ? "KnaBa · Уборка в Берлине и Бранденбурге" : "KnaBa Gebäudereinigung · Berlin & Brandenburg"} />
    <meta name="twitter:card" content="summary_large_image" />
    {pageAlternates.map(item => <link rel="alternate" hreflang={item.lang} href={new URL(item.url,siteConfig.origin)} />)}
    <title>{title}</title>
    <ClientRouter />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({"@context":"https://schema.org","@graph":[structuredData, ...pageSchemas, ...(breadcrumbSchema ? [breadcrumbSchema] : [])]}).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">{translated.skip}</a>
    {siteConfig.temporary && <div class="preview-banner"><div class="container"><span><span class="preview-dot"></span><strong>{translated.preview}</strong><span class="preview-domain"> · kneba.vsp.rest</span></span><a href={siteConfig.officialOrigin}>{translated.official} <span aria-hidden="true">↗</span></a></div></div>}
    <div class="topline">
      <div class="container">
        <span
          ><span class="dot"></span> {translated.region}</span
        ><a href={company.phoneHref}
          ><Icon name="phone" size={14} />{company.phone}</a>
      </div>
    </div>
    <header class="header">
      <div class="container nav-wrap">
        <a
          href={homePath}
          class="brand"
          aria-label={lang === 'ru' ? 'KnaBa — главная страница' : 'KnaBa Gebäudereinigung – Startseite'}
          ><span class="brand-mark"
            ><span></span><span></span><span></span></span
          ><span class="brand-type">KnaBa<span>{lang === 'ru' ? 'ПРОФЕССИОНАЛЬНАЯ УБОРКА' : 'GEBÄUDEREINIGUNG'}</span></span></a
        >
        <nav class="desktop-nav" aria-label={lang === 'de' ? 'Hauptnavigation' : lang === 'uk' ? 'Головна навігація' : lang === 'ru' ? 'Главная навигация' : 'Main navigation'}>
          {
            nav.map(([href, text]) => (
              <a
                href={href}
                aria-current={path.startsWith(href) ? "page" : undefined}
              >
                {text}
              </a>
            ))
          }
        </nav>
        <a class="button button-dark nav-cta" href={localPath("/kontakt/")}
          >{translated.quote} <Icon size={17} /></a
        >
        <a class="account-link" href={localPath("/konto/")}>{translated.account} ↗</a>
        <details class="site-language-switcher">
          <summary aria-label={`${languageLabel}: ${languageNames[lang]}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3c2.6 2.7 4.1 5.8 4.1 9S14.6 18.3 12 21M12 3C9.4 5.7 7.9 8.9 7.9 12S9.4 18.3 12 21" />
            </svg>
            <span class="language-trigger-code">{lang.toUpperCase()}</span>
            <span class="language-chevron" aria-hidden="true"></span>
          </summary>
          <nav class="site-language-options" aria-label={languageLabel}>
            {languages.map(item => <a data-language-switch href={item.url} lang={item.lang} hreflang={item.lang} aria-current={lang===item.lang?'page':undefined}>
              <span>{languageNames[item.lang]}</span><span class="site-language-code" aria-hidden="true">{item.lang.toUpperCase()}</span>
            </a>)}
          </nav>
        </details>
        <details class="mobile-nav">
          <summary aria-label={translated.menu}
            ><span>{translated.menu}</span><span class="menu-lines">☰</span></summary
          ><nav aria-label={lang === 'de' ? 'Mobile Hauptnavigation' : lang === 'uk' ? 'Мобільна навігація' : lang === 'ru' ? 'Мобильная навигация' : 'Mobile navigation'}>
            {nav.map(([href, text]) => <a href={href}>{text}</a>)}<a
              href={localPath("/kontakt/")}>{translated.quote} →</a><a href={localPath("/konto/")}>{translated.account}</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1">{breadcrumbs.length > 0 && <nav class="container breadcrumbs" aria-label={lang === 'de' ? 'Brotkrümelnavigation' : lang === 'ru' ? 'Путь к странице' : 'Breadcrumb'}><ol>{breadcrumbs.map((item,index)=><li>{index === breadcrumbs.length-1 ? <span aria-current="page">{item.name}</span> : <a href={item.url}>{item.name}</a>}</li>)}</ol></nav>}<slot /></main>
    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <a class="brand footer-brand" href={homePath}
            ><span class="brand-mark"
              ><span></span><span></span><span></span></span
            ><span class="brand-type">KnaBa<span>{lang === 'ru' ? 'ПРОФЕССИОНАЛЬНАЯ УБОРКА' : 'GEBÄUDEREINIGUNG'}</span></span
            ></a
          ><p>{translated.tagline}</p><span
            class="footer-region">{lang === 'ru' ? 'Берлин и Бранденбург' : 'Berlin & Brandenburg'}</span>
        </div>
        <div>
          <h2>{translated.discover}</h2><a href={localPath("/planer/")}>{footerLabels[0]}</a><a href={localPath("/leistungen/")}>{footerLabels[1]}</a><a
            href={localPath("/branchen/")}>{footerLabels[2]}</a
          ><a href={localPath("/ratgeber/")}>{footerLabels[3]}</a><a href={localPath("/berlin/")}>{footerLabels[4]}</a><a href={localPath("/konto/")}>{translated.account}</a><a href={localPath("/unternehmen/")}>{footerLabels[5]}</a><a href={localPath("/karriere/")}
            >{footerLabels[6]}</a>
        </div>
        <div>
          <h2>{translated.contact}</h2><a href={company.phoneHref}>{company.phone}</a><a
            href={`mailto:${company.email}`}>{company.email}</a
          ><p>{company.street}<br />{company.city}</p>
        </div>
        <div>
          <h2>{translated.next}</h2><p>
            {translated.nextText}
          </p><a href={localPath("/kontakt/")} class="text-link light"
            >{translated.quote} <Icon size={18} /></a>
        </div>
      </div>
      {siteConfig.temporary && <div class="container preview-footer"><span class="preview-dot"></span><p>{translated.retire} <a href={siteConfig.officialOrigin}>knaba.de ↗</a></p></div>}
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} KnaBa</span><div>
          <a href={localPath("/impressum/")}>{translated.imprint}</a><a href={localPath("/datenschutz/")}
            >{translated.privacy}</a>
        </div>
      </div>
    </footer>
    <div class="knaba-widget-root" data-knaba-widget data-locale={lang}>
      <button type="button" data-knaba-open aria-label="KNABA Assistant öffnen"><span aria-hidden="true">✳</span> KNABA Assistant</button>
    </div>
    <script>
      async function mountAssistant(button: HTMLButtonElement) {
        const root=button.closest<HTMLElement>('[data-knaba-widget]');
        if(!root || root.dataset.pending==='true')return;
        root.dataset.pending='true';button.disabled=true;
        try {
          const [{render},{default:KnabaAssistant}]=await Promise.all([
            import('solid-js/web'),
            import('../components/KnabaAssistant.tsx')
          ]);
          const language=root.dataset.locale as 'de'|'en'|'uk'|'ru';
          root.replaceChildren();
          const dispose=render(()=>KnabaAssistant({locale:language,initialOpen:true}),root);
          document.addEventListener('astro:before-swap',()=>dispose(),{once:true});
        }catch{
          button.disabled=false;root.dataset.pending='false';
          window.location.href=document.documentElement.lang==='ru'?'/ru/kontakt/':'/kontakt/';
        }
      }
      function bindLauncher(){
        document.querySelectorAll<HTMLButtonElement>('[data-knaba-open]').forEach(button=>{
          if(button.dataset.bound==='true')return;
          button.dataset.bound='true';
          button.addEventListener('click',()=>void mountAssistant(button));
        });
      }
      bindLauncher();
      document.addEventListener('astro:page-load',bindLauncher);
    </script>
    <script>
      import { initializeSiteStudioLive } from "../scripts/site-studio-live";
      initializeSiteStudioLive();
    </script>
    <script>
      import { services } from '../data/company';
      function preserveServiceSelection() {
        const selected = new URLSearchParams(location.search).get('leistung');
        if (!selected || !services.some(service => service.slug === selected)) return;
        document.querySelectorAll<HTMLAnchorElement>('a[data-language-switch]').forEach(link => {
          const target = new URL(link.href);
          if (target.origin === location.origin && /^\/(?:ru\/)?kontakt\/$/.test(target.pathname)) {
            target.searchParams.set('leistung', selected);
            link.href = target.href;
          }
        });
      }
      preserveServiceSelection();
      document.addEventListener('astro:page-load', preserveServiceSelection);

      const disclosures = ".mobile-nav, .site-language-switcher";
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        document.querySelectorAll<HTMLDetailsElement>(disclosures).forEach((menu) => {
          if (!menu.open) return;
          menu.open = false;
          menu.querySelector("summary")?.focus();
        });
      });
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        document.querySelectorAll<HTMLDetailsElement>(disclosures).forEach((menu) => {
          if (menu.open && !menu.contains(target)) menu.open = false;
        });
      });
    </script>
  </body>
</html>
