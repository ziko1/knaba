# Set server-only via Sites runtime secret store. Never prefix with PUBLIC_.
OWNER_EMAIL=
# Build-time only; omit for the temporary preview. Future approved official release:
# KNABA_RELEASE_MODE=official

# Build-time PUBLIC destinations; do not configure until KNABA confirms ownership.
# E.164 digits only; published landline does not prove WhatsApp Business access.
# KNABA_VERIFIED_WHATSAPP_NUMBER=491701234567
# Telegram BotFather public username without @, ending in bot.
# KNABA_VERIFIED_TELEGRAM_BOT=ExampleContactBot
# Neither variable is a provider token or enables webhook/outbound/voice.
