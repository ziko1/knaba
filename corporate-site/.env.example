# Set server-only via Sites runtime secret store. Never prefix with PUBLIC_.
OWNER_EMAIL=
# Build-time only; omit for the temporary preview. Future approved official release:
# KNABA_RELEASE_MODE=official
# VPS runtime only. Empty = socket peer, forwarded headers ignored.
# Set only exact, verified reverse-proxy IPs; never wildcard/CIDR or client IPs.
# The trusted edge must overwrite X-Forwarded-For or append its socket peer.
KNABA_TRUSTED_PROXY_IPS=
