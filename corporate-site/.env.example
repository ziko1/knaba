# Set server-only via Sites runtime secret store. Never prefix with PUBLIC_.
OWNER_EMAIL=\n# KNABA_DEVELOPER_EMAIL must be DIFFERENT and separately enrolled with invite-developer.\nKNABA_DEVELOPER_EMAIL=\n# OAuth is disabled unless both client ID and secret are provisioned on the protected server.\nKNABA_GOOGLE_CLIENT_ID=\nKNABA_GOOGLE_CLIENT_SECRET=\n# Microsoft: single verified tenant UUID (no common/organizations wildcard).\nKNABA_MICROSOFT_TENANT_ID=\nKNABA_MICROSOFT_CLIENT_ID=\nKNABA_MICROSOFT_CLIENT_SECRET=
# Build-time only; omit for the temporary preview. Future approved official release:
# KNABA_RELEASE_MODE=official

# Optional KNABA Mobile distribution. Leave unset until real signed artifacts are verified.
# HTTPS Android APK on the company host, a configured company distribution host, or the ziko1/knaba GitHub release.
KNABA_ANDROID_APK_URL=
# Only set for a domain controlled by the new KNABA server operator, e.g. mobile.knaba.de
KNABA_MOBILE_DISTRIBUTION_HOST=
# Verified Apple TestFlight invitation or published App Store link only.
KNABA_IOS_INSTALL_URL=
# Optional separate ERP public HTTPS origin (not a login token), e.g. https://erp.example.de
KNABA_ERP_PUBLIC_ORIGIN=
