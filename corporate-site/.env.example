# Set server-only via Sites runtime secret store. Never prefix with PUBLIC_.
OWNER_EMAIL=
# Build-time only; omit for the temporary preview. Future approved official release:
# KNABA_RELEASE_MODE=official

# Optional Google OIDC identity integration: disabled by default.
# Configure ONLY in protected VPS environment, never commit client secrets.
# A verified owner and separate business privacy approval are required first.
KNABA_GOOGLE_LOGIN_ENABLED=0
# KNABA_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# KNABA_GOOGLE_CLIENT_SECRET=server-only-secret-from-google-console
# Before activation: backed-up, explicitly approved 'migrate-google-auth' schema.
