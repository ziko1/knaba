{
  "name": "knaba-unified-integration",
  "private": true,
  "version": "0.0.0-integration",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "audit:source": "node scripts/verify-snapshot.mjs",
    "check:site": "npm --prefix corporate-site run check",
    "test:site": "npm --prefix corporate-site test",
    "check:erp": "npm --prefix erp run typecheck",
    "test:erp": "npm --prefix erp test",
    "audit:release": "node scripts/verify-release-readiness.mjs",
    "test:release-policy": "node --test scripts/release-readiness.test.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:source": "node --test scripts/verify-snapshot.test.mjs"
  }
}
