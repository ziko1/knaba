  "findings": [
    {
      "id": "ANDROID-F3-R1",
      "severity": "high",
      "path": "erp/apps/mobile-android/app/src/main/java/de/knaba/mobile/ErpConsoleTransport.java",
      "boundary": "adoptFederation -> restorePending -> linked nativeMedia journal",
      "observation": "Linked media journal read/parse failures are caught and reduced to blockedNativeMediaKey, allowing the candidate to retire the old client. Other media-only pending state is not preflight-read. This contradicts the agreed fail-closed preparation boundary.",
      "requiredCorrection": "Use an adoption-scoped bounded journal preflight; unavailable/corrupt reads or structurally inconsistent linkage fail before retirement with old account and journal bytes preserved. Preserve valid historical UNKNOWN records in blocked/read-only recovery; a historical authority difference alone is not corruption. Preserve normal-login behavior."
    },
    {
      "id": "ANDROID-F3-R2",
      "severity": "medium",
      "path": "erp/apps/mobile-android/app/src/main/java/de/knaba/mobile/ErpConsoleActivity.kt",
      "boundary": "goBack/signOut AlertDialog positive callbacks",
      "observation": "A pending-command confirmation can be open on the federation screen while the candidate finishes. Its positive callback lacks screen/transport fencing and can invoke an old leave action against the newly adopted UI. Other positive logout callbacks share the same mutable-account pattern.",
      "requiredCorrection": "Capture the user-intent screen and exact client (and applicable revision) before showing the dialog; ignore an obsolete positive callback. Add the delayed-confirmation regression without weakening existing assertions."
    }
  ],
