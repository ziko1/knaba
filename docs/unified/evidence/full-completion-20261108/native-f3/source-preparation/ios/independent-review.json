  "resolvedFindings": [
    {
      "id": "IOS-F3-01",
      "severity": "MEDIUM",
      "status": "CORRECTED_SOURCE_XCTEST_PENDING",
      "title": "Swift Task cancellation after VERIFIED was not checked at the MainActor commit boundary",
      "v1SourceManifestSha256": "f5aa078a5d313ebe973e5539facc5b9614c56d51188d750698d56d77314088ff",
      "paths": [
        "erp/apps/mobile-ios/Sources/ERPFederationLogin.swift",
        "erp/apps/mobile-ios/Sources/ERPConsoleView.swift"
      ],
      "sourceTrace": "After the last client Task.checkCancellation and actor hop, adoptWebsite calls verified.commit; v1 checked only the ticket. The browser task-cancellation handler had already ended. Task.cancel alone therefore did not cancel the active ticket before retirement/installation.",
      "reproducer": "Pause openWebsiteSignIn with the existing beforeCommit gate after VERIFIED; cancel that Swift Task without explicit UI/ticket cancellation; release the gate. v1 source reaches previousLifetime.retire/install. This source trace was not executed locally.",
      "correction": "Three Task.checkCancellation guards before ticket commit and before/after the bounded journal read; one paused-VERIFIED model regression added. The other 17 frozen paths are unchanged.",
      "newRegression": "ERPFederationModelTests.testTaskCancellationAtVerifiedMainHandoffPreservesOldAccountWithoutExplicitUICancel",
      "actualRedGreen": "NOT_RUN_SWIFT_XCODE_UNAVAILABLE"
    }
  ],
  "blockingFindings": [],
  "method": "Independent read-only protocol/runtime/UI/config/test source review plus exact hashes, Git preimages/preservation and authored declaration inventory. Existing author portable logs verified; no repeated portable tests or Swift/Xcode invocation.",
  "checks": {
    "mainActorAdoption": "Candidate is private until verified current /me; final synchronous commit checks ticket, Swift Task cancellation, previous lifetime, wall/monotonic deadlines and bounded journal state before permanent old-client retirement and new client+actor+CSRF/UI installation. No await/network between retirement and install.",
    "originalAuthority": "Old client actor generation/origin and full canonical server actor fields plus CSRF fence the attempt. Same-user role/permission/warehouse/future scope refresh cancels ticket. mfaVerifiedAt timestamp alone is omitted; actual mfaVerified boolean remains part of the fingerprint.",
    "intentAndRetirement": "UI callbacks capture client/epoch/revision/origin at tap. Network methods retain the captured client across await. Explicit logout cancels/clears synchronously and captures old client for later reduction. Retired lifetime cannot be reopened by reset/configure/login; old media fence is permanently invalid.",
    "candidateAndUnknownOutcome": "Only exact token HTTP200, same endpoint, one fresh KF3 cookie distinct from captured old cookie, host-only Secure/HttpOnly/Strict/path and valid expiry metadata. Start/token have no old cookie; explicit recovery reads only the captured candidate, never repeats token or uses old /me. Complete token identity user/company/CSRF must match current candidate /me.",
    "errorsAndRecovery": "Candidate parse/auth/outage failure uses independent federation error path and preserves old account. Missing candidate requires restart. Same start key/body are retained only for explicit start retry. Corrupt/unavailable/changed required journal aborts commit; valid pending records remain retained/read-only. No journal deletion or auth-secret persistence added.",
    "expiry": "Server/local pending deadline and token/cookie caps combine with120s candidate recovery; monotonic uptime prevents wall-clock rollback extension. /me supplies no invented expiry. Final commit rechecks deadline and cancellation around synchronous journal work.",
    "browserAndLifecycle": "Single ASWebAuthenticationSession uses the actual control window; no fallback fabricated window, custom Cookie/header injection or general arbitrary deeplink. Exact callback base/state/code/ERP issuer/three query keys and no fragment. Background cancellation preserves old account; modal inactivity alone does not log out.",
    "testAndRelease": "Compiled registry requires DEBUG and KNABA_FEDERATION_TEST and exact TEST tuple. Fresh health and profiles require TEST. Source Debug plist parity/Release-empty registry guards preserve bundle/version/minimum/signing/location keys. Generated settings and built Debug plist are checked by the existing future macOS build path; Release compile remains separate.",
    "sourceAndEvidence": {
      "all19FrozenHashesAndPreimagesVerified": true,
