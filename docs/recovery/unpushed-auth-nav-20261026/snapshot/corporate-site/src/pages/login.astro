---
import Layout from '../layouts/Layout.astro';
import AuthHub from '../components/AuthHub.tsx';
---
<Layout title="KnaBa | Sicher anmelden" description="Geschützter KnaBa Zugang für berechtigte Kunden, Mitarbeitende und Partner." noindex={true}>
  <section class="kauth-page" aria-label="KnaBa Anmeldung">
    <h1 class="sr-only">KnaBa Anmeldung</h1>
    <AuthHub mode="login" client:load/>
    <noscript><div class="container"><p>Für die Anmeldung ist JavaScript erforderlich. Kontakt: <a href="mailto:kontakt@knaba.de">kontakt@knaba.de</a>.</p></div></noscript>
  </section>
</Layout>
