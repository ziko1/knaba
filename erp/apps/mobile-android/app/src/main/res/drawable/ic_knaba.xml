<?xml version="1.0" encoding="utf-8"?>
<!--
    Reuse corporate-site/public/favicon.png byte-for-byte: the approved
    three-building KNABA mark, not the historical cleaning-tool glyph.
    At 108dp, these insets keep the colored mark inside the 66dp safe circle.
    The white bitmap field blends with the adaptive icon's white background.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="19%"
    android:insetTop="19%"
    android:insetRight="19%"
    android:insetBottom="19%">
    <bitmap
        android:src="@drawable/ic_knaba_brand"
        android:gravity="fill"
        android:filter="true" />
</inset>
