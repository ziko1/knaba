# Copy into a PRIVATE file; scripts/bootstrap-local.sh creates runnable DEMO values.
# Never commit a populated environment file. Do not reuse AVENQO assets or credentials.
APP_MODE=DEMO
COMPANY_ID=knaba-demo
POSTGRES_DB=knaba
POSTGRES_USER=knaba
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knaba:REPLACE_PASSWORD@postgres:5432/knaba
API_PORT=3000
# Generate a private value with openssl rand -hex 32; retain for encrypted TOTP recovery.
AUTH_ENCRYPTION_KEY=
# Fill using git rev-parse HEAD after the tested source is committed.
GIT_SHA=
PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated confirmed company website origins allowed to embed the widget.
WIDGET_ALLOWED_ORIGINS=
# All real sends remain disabled until authorization and account evidence are recorded.
LIVE_SEND_ALLOWED=false
WHATSAPP_ACCOUNT_CAPABILITIES_VERIFIED=false
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PUBLIC_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEST_RECIPIENTS=
# Generic inbound and outbound use these server-side credential mappings only.
# Empty disables inbound auth; credentials alone do not enable outbound requests.
INTEGRATION_CREDENTIALS_JSON=
LIVE_INTEGRATION_SEND_ALLOWED=false
# Configure private API/Worker secret-store values together; never commit a populated JSON.
# Synthetic shape only; replace every placeholder and configure current key validity:
# [{"source":"synthetic_crm","companyId":"REPLACE_COMPANY_ID","keyId":"key_2026_10","secret":"REPLACE_WITH_PRIVATE_64_HEX_CHAR_RANDOM_KEY","enabled":true,"notBefore":"2026-10-08T00:00:00Z","notAfter":"2026-11-08T00:00:00Z"}]
# Rotation may overlap keyIds for the same source/company; expired/disabled keys deny access.
# Outbound also requires preview/confirmation and a current recorded PRIVACY legal_approval:
# scope.integrationOutbound sources, exact HTTPS endpoints, allowedEventTypes=["lead.status"],
# allowedFields=["id","status","review_state","language"]. Use its ID as approvalReference.
# Keep live sends false until actual company/provider/legal checks and authorization exist.
# AI is independently gated by provider configuration and recorded transfer approval.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REGION=
AI_TRANSFER_APPROVAL_ID=
AI_SYNTHETIC_ONLY=true
AI_INPUT_PRICE_PER_MILLION_CENTS=100
AI_OUTPUT_PRICE_PER_MILLION_CENTS=200

# PDF uploads require a deployed approved private ClamAV service; empty keeps them closed.
MEDIA_SCANNER_URL=
# Optional private object storage; default is transactionally backed PostgreSQL.
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=
