[Unit]
Description=Account-scoped website operation broker
After=docker.service

[Service]
Type=simple
User=root
Group=sitepanel
ExecStart=/usr/bin/python3 -I /usr/local/libexec/sitepanel/sitepanel.py serve
RuntimeDirectory=sitepanel
RuntimeDirectoryMode=0750
StateDirectory=sitepanel
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sitepanel /run/sitepanel /srv/knaba/customer
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=true
MemoryMax=256M
CPUQuota=50%
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
